---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	image?: string | ImageMetadata;
	alt?: string;
	className?: string;
	loading?: 'eager' | 'lazy';
	sizes?: string;
}

const {
	image,
	alt = '',
	className,
	loading = 'lazy',
	sizes = '(min-width: 50rem) 33vw, 100vw',
} = Astro.props;
const isPublicImage = typeof image === 'string';
---

<div class:list={['card-thumbnail', className, !image && 'card-thumbnail--empty']}>
	{image ? (
		isPublicImage ? (
			<img src={image as string} alt={alt} loading={loading} decoding="async" width="640" height="360" />
		) : (
			<Image
				src={image as ImageMetadata}
				alt={alt}
				width={640}
				height={360}
				widths={[480, 640, 960]}
				sizes={sizes}
				loading={loading}
				decoding="async"
			/>
		)
	) : (
		<span class="card-thumbnail__fallback" aria-hidden="true"></span>
	)}
</div>
