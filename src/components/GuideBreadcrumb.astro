---
import { game } from '../config/game';
import { routeForGuide } from '../lib/routes';

const entry = Astro.locals.starlightRoute.entry;
const route = routeForGuide(entry);
const allRoutesPath = game.allRoutesPath;
---

<nav class="gw-crumb" aria-label="Breadcrumb">
	<ol>
		<li><a href={allRoutesPath}>All Guides</a></li>
		{route && (
			<li><a href={route.path}>{route.label}</a></li>
		)}
	</ol>
</nav>
