---
import GuideCard from './GuideCard.astro';
import type { GuideEntry } from '../lib/guides';
import { resolveEntryCardImage, sortCardsByImage } from '../lib/assets';
import { guideHref } from '../lib/guides';

interface Props {
	entries: GuideEntry[];
	featured?: boolean;
}

const { entries, featured = false } = Astro.props;
const orderedEntries = sortCardsByImage(entries, (entry) => resolveEntryCardImage(entry, guideHref(entry)));
---

{
	entries.length > 0 && (
		<div class:list={['gw-grid', featured && 'gw-grid--featured']}>
			{orderedEntries.map((entry) => (
				<GuideCard {entry} featured={featured} />
			))}
		</div>
	)
}
