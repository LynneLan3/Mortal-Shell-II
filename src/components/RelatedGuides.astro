---
import { getGuides, guideHref, resolveRelated } from '../lib/guides';

const entry = Astro.locals.starlightRoute.entry;
const slugs = entry.data.related ?? [];
const allRelated =
	slugs.length > 0 ? resolveRelated(await getGuides(), slugs, entry.id) : [];
const related = allRelated.slice(0, 3);
---

{
	related.length > 0 && (
		<section class="gw-related" aria-labelledby="gw-related-heading">
			<span class="gw-related__eyebrow">CONTINUE YOUR RUN</span>
			<h2 id="gw-related-heading">Next Guides</h2>
			<ul>
				{related.map((guide) => (
					<li>
						<a href={guideHref(guide)}>
							<span class="gw-related__title">{guide.data.title}</span>
							{guide.data.description && (
								<span class="gw-related__desc">{guide.data.description}</span>
							)}
							<span class="gw-related__arrow">→</span>
						</a>
					</li>
				))}
			</ul>
		</section>
	)
}
