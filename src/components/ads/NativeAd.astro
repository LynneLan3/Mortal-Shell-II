---
/**
 * Adsterra Native Banner mid-article slot.
 * Soft-offline when ADSTERRA_ENABLED=false: renders nothing (no empty box).
 * Script URL, container ID, and placement stay in src/lib/adsterra.ts for restore.
 */
import AdSlot from './AdSlot.astro';
import {
	ADSTERRA_CONTAINER_ID,
	ADSTERRA_INVOKE_SRC,
	ADSTERRA_PLACEMENT,
	ADSTERRA_SLOT_NAME,
	isAdsterraRuntimeEnabled,
} from '../../lib/adsterra';

const enabled = isAdsterraRuntimeEnabled();
const adScript = ADSTERRA_INVOKE_SRC;
const containerId = ADSTERRA_CONTAINER_ID;
---

{
	enabled && (
		<AdSlot name={ADSTERRA_SLOT_NAME} placement={ADSTERRA_PLACEMENT} minHeight="250px">
			<script async="async" data-cfasync="false" src={adScript}></script>
			<div id={containerId} data-adsterra-container></div>
		</AdSlot>
	)
}
