---
import {
	achievementCategories,
	achievementDefinitions,
	achievementObjectiveCount,
} from '../../data/achievement-definitions';
import { mapMarkerById } from '../../data/map-markers';
import { mapRoutes } from '../../data/map-routes';
import { TOOLKIT_CATEGORIES, toolkitItemById, toolkitItems } from '../../data/toolkit-items';
import { getCanonicalMapProgress } from '../../lib/toolkit-progress';

interface Props { draft?: boolean; }

const { draft = false } = Astro.props;

const storageKey = 'ms2-toolkit-progress-v1';
const mappedObjectiveIds = new Set(toolkitItems.filter((item) => item.mapMarkerId).map((item) => item.id));
const completionCategories = [...TOOLKIT_CATEGORIES, 'Achievements', 'Other'] as const;
const clientData = {
	achievements: achievementDefinitions.map((achievement) => ({
		...achievement,
		total: achievementObjectiveCount(achievement),
	})),
	objectives: toolkitItems.map((item) => ({
		id: item.id,
		name: item.name,
		category: item.category,
		region: item.region ?? '',
		mapMarkerId: item.mapMarkerId ?? '',
	})),
	routes: mapRoutes.map((route) => ({
		id: route.id,
		name: route.name,
		waypoints: route.waypoints.map((waypoint) => toolkitItems.find((item) => item.mapMarkerId === waypoint.markerId)?.id ?? waypoint.markerId),
	})),
};
---

<section class="completion-workspace" data-achievement-workspace data-storage-key={storageKey} data-completion-draft={draft ? 'true' : undefined} aria-labelledby="completion-workspace-title">
	<script type="application/json" data-achievement-json set:html={JSON.stringify(clientData)}></script>
	<header class="completion-workspace__hero">
		<div class="completion-workspace__hero-main">
			<p class="completion-workspace__eyebrow">Completion Dashboard</p>
			<h2 id="completion-workspace-title">Completion</h2>
			<div class="completion-workspace__score-row">
				<strong data-completion-overall-percent>0%</strong>
				<div>
					<p><span data-completion-achievements-done>0</span> / {achievementDefinitions.length} achievements</p>
					<span class="completion-workspace__muted">Target: 100% · shared with map markers and routes.</span>
				</div>
			</div>
			<div class="completion-workspace__overall-bar" aria-label="Overall achievement completion"><span data-completion-overall-bar></span></div>
		</div>
		<div class="completion-workspace__hero-side">
			<div class="completion-workspace__world-stat">
			<span>Map Progress</span>
			<strong><span data-completion-map-done>0</span> / <span data-completion-map-total>{getCanonicalMapProgress([]).total}</span></strong>
			<small>mapped objectives</small>
			</div>
			<div class="completion-workspace__attention">
				<div><span>MISSABLE</span><strong data-completion-missable>0 remaining</strong></div>
				<div><span>HIDDEN</span><strong data-completion-hidden>0 remaining</strong></div>
			</div>
		</div>
	</header>

	<section class="completion-workspace__categories" aria-label="Achievement category progress">
		{achievementCategories.map((category) => (
			<div class="completion-workspace__category" data-completion-category={category}>
				<div><span>{category}</span><strong><span data-completion-category-done>0</span> / <span data-completion-category-total>{achievementDefinitions.filter((achievement) => achievement.category === category).length}</span></strong></div>
				<div class="completion-workspace__category-bar"><span data-completion-category-bar></span></div>
			</div>
		))}
	</section>

	<section class="completion-workspace__controls" aria-label="Completion filters">
		<div class="completion-workspace__control-row">
			<label class="completion-workspace__search"><span class="sr-only">Search achievements</span><input type="search" placeholder="Search achievements, objectives..." data-completion-search /></label>
			<label class="completion-workspace__hide"><input type="checkbox" data-completion-hide-completed /> Hide Completed</label>
		</div>
		<div class="completion-workspace__filter-group" aria-label="Completion status">
			<span class="completion-workspace__filter-label">Status</span>
			{['all', 'in-progress', 'not-started', 'completed', 'missable', 'hidden'].map((filter) => <button type="button" class:list={['completion-filter-button', filter === 'all' && 'is-active']} data-completion-filter={filter}>{filter.replace('-', ' ')}</button>)}
		</div>
		<div class="completion-workspace__filter-group" aria-label="Achievement category">
			<span class="completion-workspace__filter-label">Category</span>
			<button type="button" class="completion-filter-button is-active" data-completion-category-filter="all">All</button>
			{completionCategories.map((category) => <button type="button" class="completion-filter-button" data-completion-category-filter={category}>{category}</button>)}
		</div>
	</section>

	<section class="completion-workspace__list" id="completion-achievements" aria-labelledby="completion-achievements-title">
		<div class="completion-workspace__list-head"><div><p class="completion-workspace__eyebrow">Completion Ledger</p><h3 id="completion-achievements-title">Find what remains</h3></div><span data-completion-visible-count>{toolkitItems.length + achievementDefinitions.length} cards</span></div>
		<div class="achievement-card-grid">
			{toolkitItems.map((item, index) => {
				return (
					<article
						id={item.id}
						class="achievement-card is-not-started"
						data-completion-card={item.id}
						data-completion-kind="objective"
						data-completion-category={item.category}
						data-completion-search={`${item.name} ${item.category} ${item.region ?? ''} ${item.description ?? ''}`}
						tabindex="0"
						role="button"
						aria-pressed="false"
						hidden={index >= 16}
					>
						<div class="achievement-card__topline"><div class="achievement-card__identity"><span class="achievement-card__category">{item.category}</span><h4 data-achievement-title>{item.name}</h4></div><span class="achievement-card__status" data-achievement-status>Not Started</span></div>
						<p class="achievement-card__context">{item.region ?? item.category}</p>
						<div class="achievement-card__progress-row"><strong><span data-achievement-done>0</span> / <span data-achievement-total-label>1</span></strong><span data-achievement-remaining>1 remaining</span></div>
						<div class="achievement-card__bar"><span data-achievement-bar></span></div>
						<div class="achievement-card__actions">
							{item.mapMarkerId && <a class="achievement-card__action achievement-card__action--map" href={`/mortal-shell-ii/map/?marker=${item.mapMarkerId}`}>Map <span aria-hidden="true">↗</span></a>}
							{item.guideUrl && <a class="achievement-card__guide" href={item.guideUrl} target="_blank" rel="noopener noreferrer">Guide <span aria-hidden="true">↗</span></a>}
						</div>
					</article>
				);
			})}
			{achievementDefinitions.map((achievement) => {
				const objectiveIds = achievement.objectiveIds ?? [];
				const objectives = objectiveIds.map((id) => toolkitItemById.get(id)).filter(Boolean);
				const mapTargets = objectives.filter((item) => item?.mapMarkerId && mappedObjectiveIds.has(item.id));
				const route = achievement.routeId ? mapRoutes.find((candidate) => candidate.id === achievement.routeId) : undefined;
				const sameRegion = mapTargets.length > 1 && new Set(mapTargets.map((item) => mapMarkerById.get(item?.mapMarkerId ?? '')?.sameArea ?? mapMarkerById.get(item?.mapMarkerId ?? '')?.region)).size === 1;
				const context = [...new Set(objectives.map((item) => item?.region).filter(Boolean))].slice(0, 2).join(' · ') || achievement.category;
				const cardIndex = toolkitItems.length + achievementDefinitions.indexOf(achievement);
				return (
				<article id={achievement.id} class:list={['achievement-card', achievement.missable && 'is-missable', achievement.hidden && 'is-hidden-achievement', 'is-not-started']} data-completion-card={achievement.id} data-completion-kind="achievement" data-completion-category="Achievements" data-completion-achievement-category={achievement.category} data-completion-search={`${achievement.name} ${achievement.description} ${achievement.category}`} data-achievement-card={achievement.id} data-achievement-category={achievement.category} data-achievement-type={achievement.type} data-achievement-objectives={objectiveIds.join(',')} data-achievement-total={achievementObjectiveCount(achievement)} data-achievement-manual={!objectiveIds.length} data-achievement-missable={achievement.missable ? 'true' : 'false'} data-achievement-hidden={achievement.hidden ? 'true' : 'false'} tabindex="0" role="button" aria-pressed="false" hidden={cardIndex >= 16}>
					<div class="achievement-card__topline"><div class="achievement-card__identity"><span class="achievement-card__category">{achievement.category} · {achievement.type}</span><h4 data-achievement-title>{achievement.hidden ? 'Hidden Achievement' : achievement.name}</h4></div><span class="achievement-card__status" data-achievement-status>Not Started</span></div>
					<p class="achievement-card__context" data-achievement-description>{achievement.hidden ? 'Details hidden' : context}</p>
					{(achievement.missable || achievement.hidden) && <div class="achievement-card__badges">{achievement.missable && <span class="achievement-card__warning">MISSABLE</span>}{achievement.hidden && <span class="achievement-card__warning achievement-card__warning--hidden">HIDDEN</span>}</div>}
						<div class="achievement-card__progress-row"><strong><span data-achievement-done>0</span> / <span data-achievement-total-label>{achievementObjectiveCount(achievement)}</span></strong><span data-achievement-remaining>0 remaining</span></div>
						<div class="achievement-card__bar"><span data-achievement-bar></span></div>
						{achievement.hidden && <button class="achievement-card__reveal" type="button" data-achievement-reveal>Reveal details</button>}
					{!objectives.length && achievement.type === 'counter' && <label class="achievement-card__manual-inline"><span>Current count</span><input type="number" min="0" max={achievementObjectiveCount(achievement)} value="0" data-achievement-manual-input /></label>}
						<div class="achievement-card__actions">
						{mapTargets.length > 0 && <a href={`/mortal-shell-ii/map/?achievement=${achievement.id}`} class="achievement-card__action achievement-card__action--map">Map <span aria-hidden="true">↗</span></a>}
						{route && <a href={`/mortal-shell-ii/map/?achievement=${achievement.id}&route=${route.id}`} class="achievement-card__action">Route <span aria-hidden="true">↗</span></a>}
						{!route && sameRegion && <a href={`/mortal-shell-ii/map/?achievement=${achievement.id}`} class="achievement-card__action">Area map <span aria-hidden="true">↗</span></a>}
						{achievement.guideUrl && <a href={achievement.guideUrl} class="achievement-card__guide" target="_blank" rel="noopener noreferrer">Guide <span aria-hidden="true">↗</span></a>}
						</div>
					</article>
				);
			})}
			</div>
			<p class="completion-workspace__empty" data-completion-empty hidden>No achievements match this filter.</p>
			<nav class="completion-workspace__pagination" aria-label="Completion pages" data-completion-pagination>
				<div class="completion-workspace__pagination-summary" data-completion-page-summary>Showing 1–16 of {toolkitItems.length + achievementDefinitions.length}</div>
				<div class="completion-workspace__pagination-controls">
					<button type="button" data-completion-page-prev disabled>← Previous</button>
					<div class="completion-workspace__page-numbers" data-completion-page-numbers></div>
					<button type="button" data-completion-page-next>Next →</button>
				</div>
			</nav>
		</section>

	<footer class="completion-workspace__footer"><span>Browser-local completion state · compatible with the Player Toolkit map.</span>{draft ? <div class="completion-workspace__draft-actions"><button type="button" data-completion-reset>Reset draft</button><button type="button" data-completion-cancel>Cancel</button><button type="button" data-completion-confirm>Confirm</button></div> : <button type="button" data-completion-reset>Reset completion state</button>}</footer>
</section>

<script>
	import { getCanonicalMapProgress, mergeToolkitProgressState, readToolkitProgressState } from '../../lib/toolkit-progress';

	(() => {
		const app = document.querySelector('[data-achievement-workspace]');
		if (!(app instanceof HTMLElement)) return;
		const json = app.querySelector('[data-achievement-json]');
		if (!(json instanceof HTMLScriptElement)) return;
		const data = JSON.parse(json.textContent || '{}');
		const storageKey = app.getAttribute('data-storage-key') || 'ms2-toolkit-progress-v1';
		const draftMode = app.getAttribute('data-completion-draft') === 'true';
		const cards = Array.from(app.querySelectorAll('[data-completion-card]'));
		const objectives = new Map((data.objectives || []).map((item) => [item.id, item]));
		const achievements = new Map((data.achievements || []).map((item) => [item.id, item]));
		const routes = new Map((data.routes || []).map((item) => [item.id, item]));
		const pageSize = 16;
		const validCategories = new Set(['all', 'Shells', 'Map Fragments', 'Bosses', 'Weapons', 'Sidearms', 'Achievements', 'Other']);
		let completedIds = new Set();
		let manualProgress = {};
		let activeFilter = 'all';
		let activeCategory = 'all';
		let currentPage = 1;
		const search = app.querySelector('[data-completion-search]');
		const hideCompleted = app.querySelector('[data-completion-hide-completed]');

		function readState() { const state = readToolkitProgressState(window.localStorage, storageKey); completedIds = new Set(state.completedIds); manualProgress = { ...state.achievementProgress }; activeFilter = validCategories.has(state.completionFilter) ? state.completionFilter : 'all'; activeCategory = validCategories.has(state.completionCategory) ? state.completionCategory : 'all'; if (hideCompleted instanceof HTMLInputElement) hideCompleted.checked = state.completionHideCompleted; }
		function saveState(notify = true) { const state = mergeToolkitProgressState({ completedIds: Array.from(completedIds), achievementProgress: manualProgress, completionFilter: activeFilter, completionCategory: activeCategory, completionHideCompleted: hideCompleted instanceof HTMLInputElement && hideCompleted.checked }, window.localStorage, storageKey); if (notify) window.dispatchEvent(new CustomEvent('ms2-completion-state-changed', { detail: { completedIds: state.completedIds } })); return state; }
		function persistDraft() { const state = saveState(false); window.dispatchEvent(new CustomEvent('ms2-completion-state-changed', { detail: { completedIds: state.completedIds } })); window.dispatchEvent(new CustomEvent('ms2-completion-draft-confirmed')); }
		function progressFor(achievement) {
			const ids = achievement.objectiveIds || [];
			const total = Number(achievement.total || (ids.length || 1));
			const done = ids.length ? ids.filter((id) => completedIds.has(id)).length : Math.max(0, Math.min(total, Number(manualProgress[achievement.id] || 0)));
			return { done, total, complete: done >= total, remaining: Math.max(0, total - done) };
		}
		function statusFor(achievement, progress) {
			if (progress.complete) return 'Completed';
			if (achievement.missable) return progress.done > 0 ? 'Missable · In Progress' : 'Missable';
			if (achievement.hidden) return 'Hidden';
			return progress.done > 0 ? 'In Progress' : 'Not Started';
		}
		function allProgress() { const list = Array.from(achievements.values()).map((achievement) => progressFor(achievement)); return { done: list.filter((item) => item.complete).length, total: list.length }; }
		function updateAchievementCard(card, achievement) {
			const progress = progressFor(achievement); const status = statusFor(achievement, progress);
			const put = (selector, value) => { const node = card.querySelector(selector); if (node) node.textContent = String(value); };
			put('[data-achievement-done]', progress.done); put('[data-achievement-total-label]', progress.total); put('[data-achievement-remaining]', `${progress.remaining} remaining`); put('[data-achievement-status]', status);
			const bar = card.querySelector('[data-achievement-bar]'); if (bar instanceof HTMLElement) bar.style.width = `${progress.total ? Math.round(progress.done / progress.total * 100) : 0}%`;
			card.classList.toggle('is-completed', progress.complete); card.classList.toggle('is-in-progress', !progress.complete && progress.done > 0); card.classList.toggle('is-not-started', !progress.complete && progress.done === 0); card.setAttribute('aria-pressed', String(progress.complete));
			const manualInput = card.querySelector('[data-achievement-manual-input]'); if (manualInput instanceof HTMLInputElement && document.activeElement !== manualInput) manualInput.value = String(progress.done);
		}
		function updateObjectiveCard(card, item) {
			const complete = completedIds.has(item.id);
			const put = (selector, value) => { const node = card.querySelector(selector); if (node) node.textContent = String(value); };
			put('[data-achievement-done]', complete ? 1 : 0); put('[data-achievement-total-label]', 1); put('[data-achievement-remaining]', complete ? '0 remaining' : '1 remaining'); put('[data-achievement-status]', complete ? 'Completed' : 'Not Started');
			const bar = card.querySelector('[data-achievement-bar]'); if (bar instanceof HTMLElement) bar.style.width = complete ? '100%' : '0%';
			card.classList.toggle('is-completed', complete); card.classList.toggle('is-in-progress', false); card.classList.toggle('is-not-started', !complete); card.setAttribute('aria-pressed', String(complete));
		}
		function updateCard(card) {
			const kind = card.getAttribute('data-completion-kind');
			if (kind === 'objective') {
				const item = objectives.get(card.getAttribute('data-completion-card') || '');
				if (item) updateObjectiveCard(card, item);
				return;
			}
			const achievement = achievements.get(card.getAttribute('data-completion-card') || '');
			if (achievement) updateAchievementCard(card, achievement);
		}
		function updateHero() {
			const overall = allProgress(); const percent = overall.total ? Math.round(overall.done / overall.total * 100) : 0;
			const put = (selector, value) => { const node = app.querySelector(selector); if (node) node.textContent = String(value); };
			const mapProgress = getCanonicalMapProgress(completedIds); put('[data-completion-overall-percent]', `${percent}%`); put('[data-completion-achievements-done]', overall.done); put('[data-completion-map-done]', mapProgress.done); put('[data-completion-map-total]', mapProgress.total);
			const bar = app.querySelector('[data-completion-overall-bar]'); if (bar instanceof HTMLElement) bar.style.width = `${percent}%`;
			const missable = Array.from(achievements.values()).filter((achievement) => achievement.missable && !progressFor(achievement).complete).length;
			const hidden = Array.from(achievements.values()).filter((achievement) => achievement.hidden && !progressFor(achievement).complete).length;
			put('[data-completion-missable]', `${missable} remaining`); put('[data-completion-hidden]', `${hidden} remaining`);
			app.querySelectorAll('[data-completion-category]').forEach((node) => { const category = node.getAttribute('data-completion-category'); const list = Array.from(achievements.values()).filter((achievement) => achievement.category === category); const done = list.filter((achievement) => progressFor(achievement).complete).length; const doneNode = node.querySelector('[data-completion-category-done]'); const categoryBar = node.querySelector('[data-completion-category-bar]'); if (doneNode) doneNode.textContent = String(done); if (categoryBar instanceof HTMLElement) categoryBar.style.width = `${list.length ? Math.round(done / list.length * 100) : 0}%`; });
		}
		function cardProgress(card) {
			if (card.getAttribute('data-completion-kind') === 'objective') {
				const complete = completedIds.has(card.getAttribute('data-completion-card') || '');
				return { done: complete ? 1 : 0, total: 1, complete };
			}
			const achievement = achievements.get(card.getAttribute('data-completion-card') || '');
			return achievement ? progressFor(achievement) : { done: 0, total: 1, complete: false };
		}
		function cardMatches(card) {
			const progress = cardProgress(card);
			const achievement = achievements.get(card.getAttribute('data-completion-card') || '');
			const kind = card.getAttribute('data-completion-kind');
			const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : '';
			const haystack = (card.getAttribute('data-completion-search') || '').toLowerCase();
			const statusMatch = activeFilter === 'all' || (activeFilter === 'completed' && progress.complete) || (activeFilter === 'in-progress' && !progress.complete && progress.done > 0) || (activeFilter === 'not-started' && !progress.complete && progress.done === 0) || (activeFilter === 'missable' && kind === 'achievement' && achievement?.missable) || (activeFilter === 'hidden' && kind === 'achievement' && achievement?.hidden);
			const achievementCategory = card.getAttribute('data-completion-achievement-category') || '';
			const categoryMatch = activeCategory === 'all' || (kind === 'objective' && card.getAttribute('data-completion-category') === activeCategory) || (kind === 'achievement' && (activeCategory === 'Achievements' || achievementCategory === activeCategory));
			const hide = hideCompleted instanceof HTMLInputElement && hideCompleted.checked;
			return statusMatch && categoryMatch && haystack.includes(query) && !(hide && progress.complete);
		}
		function renderPageNumbers(pageCount) {
			const container = app.querySelector('[data-completion-page-numbers]');
			if (!(container instanceof HTMLElement)) return;
			const pages = pageCount <= 7 ? Array.from({ length: pageCount }, (_, index) => index + 1) : Array.from(new Set([1, currentPage - 1, currentPage, currentPage + 1, pageCount].filter((page) => page >= 1 && page <= pageCount))).sort((a, b) => a - b);
			container.innerHTML = '';
			let previous = 0;
			pages.forEach((page) => {
				if (previous && page > previous + 1) { const ellipsis = document.createElement('span'); ellipsis.className = 'completion-workspace__page-ellipsis'; ellipsis.textContent = '…'; container.append(ellipsis); }
				const button = document.createElement('button'); button.type = 'button'; button.textContent = String(page); button.dataset.page = String(page); button.className = page === currentPage ? 'is-active' : ''; button.setAttribute('aria-label', `Go to page ${page}`); button.setAttribute('aria-current', page === currentPage ? 'page' : 'false'); button.addEventListener('click', () => { currentPage = page; applyFilters(); }); container.append(button); previous = page;
			});
		}
		function applyFilters(resetPage = false) {
			if (resetPage) currentPage = 1;
			const matches = cards.filter(cardMatches);
			const pageCount = Math.max(1, Math.ceil(matches.length / pageSize));
			if (currentPage > pageCount) currentPage = 1;
			const start = matches.length ? (currentPage - 1) * pageSize : 0;
			const pageCards = new Set(matches.slice(start, start + pageSize));
			cards.forEach((card) => { card.hidden = !pageCards.has(card); const progress = cardProgress(card); const status = progress.complete ? 'completed' : progress.done > 0 ? 'in-progress' : 'not-started'; card.querySelector('[data-achievement-status]')?.setAttribute('data-status', status); });
			const count = app.querySelector('[data-completion-visible-count]'); if (count) count.textContent = `${matches.length} card${matches.length === 1 ? '' : 's'}`;
			const empty = app.querySelector('[data-completion-empty]'); if (empty) empty.hidden = matches.length !== 0;
			const summary = app.querySelector('[data-completion-page-summary]'); if (summary) summary.textContent = matches.length ? `Showing ${start + 1}–${Math.min(start + pageSize, matches.length)} of ${matches.length}` : 'Showing 0 of 0';
			const previous = app.querySelector('[data-completion-page-prev]'); const next = app.querySelector('[data-completion-page-next]'); if (previous instanceof HTMLButtonElement) previous.disabled = currentPage <= 1; if (next instanceof HTMLButtonElement) next.disabled = currentPage >= pageCount; renderPageNumbers(pageCount);
		}
		function toggleCard(card) {
			if (card.getAttribute('data-completion-kind') === 'objective') {
				const id = card.getAttribute('data-completion-card') || ''; if (completedIds.has(id)) completedIds.delete(id); else completedIds.add(id);
			} else {
				const achievement = achievements.get(card.getAttribute('data-completion-card') || ''); if (!achievement) return;
				const progress = progressFor(achievement); const nextComplete = !progress.complete;
				if (achievement.objectiveIds?.length) achievement.objectiveIds.forEach((id) => nextComplete ? completedIds.add(id) : completedIds.delete(id)); else manualProgress[achievement.id] = nextComplete ? progress.total : 0;
			}
			if (!draftMode) saveState(); render();
		}
		function isSecondaryTarget(target) { return target instanceof Element && Boolean(target.closest('a,button,input,textarea,select')); }
		function render() { cards.forEach((card) => updateCard(card)); updateHero(); applyFilters(); }
		app.querySelectorAll('[data-completion-filter]').forEach((button) => button.addEventListener('click', () => { activeFilter = button.getAttribute('data-completion-filter') || 'all'; app.querySelectorAll('[data-completion-filter]').forEach((candidate) => candidate.classList.toggle('is-active', candidate === button)); if (!draftMode) saveState(); applyFilters(true); }));
		app.querySelectorAll('[data-completion-category-filter]').forEach((button) => button.addEventListener('click', () => { activeCategory = button.getAttribute('data-completion-category-filter') || 'all'; app.querySelectorAll('[data-completion-category-filter]').forEach((candidate) => candidate.classList.toggle('is-active', candidate === button)); if (!draftMode) saveState(); applyFilters(true); }));
		search?.addEventListener('input', () => { if (!draftMode) saveState(); applyFilters(true); }); hideCompleted?.addEventListener('change', () => { if (!draftMode) saveState(); applyFilters(true); });
		const previousPage = app.querySelector('[data-completion-page-prev]'); const nextPage = app.querySelector('[data-completion-page-next]'); previousPage?.addEventListener('click', () => { if (currentPage > 1) { currentPage -= 1; applyFilters(); } }); nextPage?.addEventListener('click', () => { currentPage += 1; applyFilters(); });
		cards.forEach((card) => { card.addEventListener('click', (event) => { if (!isSecondaryTarget(event.target)) toggleCard(card); }); card.addEventListener('keydown', (event) => { if ((event.key === 'Enter' || event.key === ' ') && !isSecondaryTarget(event.target)) { event.preventDefault(); toggleCard(card); } }); });
		app.querySelectorAll('[data-achievement-reveal]').forEach((button) => button.addEventListener('click', () => { const card = button.closest('[data-achievement-card]'); if (!(card instanceof HTMLElement)) return; card.classList.add('is-revealed'); const achievement = achievements.get(card.getAttribute('data-achievement-card') || ''); if (achievement) { const title = card.querySelector('[data-achievement-title]'); const description = card.querySelector('[data-achievement-description]'); if (title) title.textContent = achievement.name; if (description) description.textContent = achievement.description; } button.remove(); }));
		app.querySelectorAll('[data-achievement-manual-input]').forEach((input) => input.addEventListener('input', () => { const card = input.closest('[data-achievement-card]'); const id = card?.getAttribute('data-achievement-card'); const achievement = id ? achievements.get(id) : undefined; if (!id || !achievement) return; manualProgress[id] = Math.max(0, Math.min(Number(achievement.total || 0), Number(input.value || 0))); if (!draftMode) saveState(); render(); }));
		app.querySelector('[data-completion-reset]')?.addEventListener('click', () => { if (draftMode) { completedIds = new Set(); manualProgress = {}; render(); return; } if (!window.confirm('Reset all completion progress on this device?')) return; completedIds = new Set(); manualProgress = {}; saveState(); render(); });
		app.querySelector('[data-completion-cancel]')?.addEventListener('click', () => window.dispatchEvent(new CustomEvent('ms2-completion-draft-cancel')));
		app.querySelector('[data-completion-confirm]')?.addEventListener('click', persistDraft);
		if (draftMode) window.addEventListener('ms2-completion-draft-open', () => { readState(); app.querySelectorAll('[data-completion-filter]').forEach((button) => button.classList.toggle('is-active', button.getAttribute('data-completion-filter') === activeFilter)); app.querySelectorAll('[data-completion-category-filter]').forEach((button) => button.classList.toggle('is-active', button.getAttribute('data-completion-category-filter') === activeCategory)); render(); });
		if (draftMode) window.addEventListener('ms2-completion-draft-cancel', () => { readState(); render(); });
		if (draftMode) window.addEventListener('ms2-completion-draft-reset', () => { readState(); render(); });
		readState();
		app.querySelectorAll('[data-completion-filter]').forEach((button) => button.classList.toggle('is-active', button.getAttribute('data-completion-filter') === activeFilter));
		app.querySelectorAll('[data-completion-category-filter]').forEach((button) => button.classList.toggle('is-active', button.getAttribute('data-completion-category-filter') === activeCategory));
		render();
	})();
</script>
