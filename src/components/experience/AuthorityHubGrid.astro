---
import type { GameAuthorityHub } from '../../config/game';
import { cardDensity, hasFeatureLast } from '../../lib/card-density';

interface Props {
	hubs: readonly GameAuthorityHub[];
}

const { hubs } = Astro.props;
const density = cardDensity(hubs.length, 3);
const featureLast = hasFeatureLast(hubs.length, 3);
---

{hubs.length > 0 && (
	<div class:list={['exp-authority-grid', `exp-authority-grid--${density}`, featureLast && 'exp-authority-grid--feature-last']}>
		{hubs.map((hub, index) => (
			<a class:list={['exp-authority-card', featureLast && index === hubs.length - 1 && 'exp-authority-card--wide']} href={hub.href}>
				<span class="exp-authority-card__label">{hub.label}</span>
				<span class="exp-authority-card__description">{hub.description}</span>
				<span class="exp-authority-card__arrow" aria-hidden="true">→</span>
			</a>
		))}
	</div>
)}

<style is:global>
	.exp-authority-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.75rem;
		align-items: start;
	}
	.exp-authority-card {
		display: grid;
		gap: 0.5rem;
		min-width: 0;
		padding: 1rem;
		border: 1px solid color-mix(in srgb, var(--game-accent, #7c3aed) 30%, transparent);
		background: color-mix(in srgb, var(--sl-color-gray-6, #1a1f28) 72%, transparent);
		text-decoration: none;
		transition: border-color 160ms ease, transform 160ms ease;
	}
	.exp-authority-card:hover,
	.exp-authority-card:focus-visible {
		border-color: var(--game-accent, #7c3aed);
		transform: translateY(-2px);
	}
	.exp-authority-card__badge {
		color: var(--game-accent, #7c3aed);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.exp-authority-card__label {
		font-size: 1rem;
		font-weight: 700;
	}
	.exp-authority-card__description {
		color: var(--sl-color-gray-2, #9aa5b4);
		font-size: 0.82rem;
		line-height: 1.45;
	}
	.exp-authority-card__arrow {
		align-self: end;
		color: var(--game-accent, #7c3aed);
		font-size: 1.1rem;
	}
	@media (min-width: 50rem) {
		.exp-authority-grid--single { grid-template-columns: 1fr; }
		.exp-authority-grid--pair { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.exp-authority-grid--balanced,
		.exp-authority-grid--dense,
		.exp-authority-grid--odd { grid-template-columns: repeat(3, minmax(0, 1fr)); }
		.exp-authority-grid--feature-last .exp-authority-card--wide { grid-column: 1 / -1; }
		.exp-authority-card--wide {
			grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.4fr) auto;
			align-items: center;
		}
		.exp-authority-card--wide .exp-authority-card__arrow { align-self: center; }
	}
	@media (min-width: 42rem) and (max-width: 49.99rem) {
		.exp-authority-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.exp-authority-grid--single { grid-template-columns: 1fr; }
		.exp-authority-grid--feature-last .exp-authority-card--wide { grid-column: 1 / -1; }
	}
</style>
