---
import type { CardImage } from '../../lib/assets';
import type { BossEntity } from '../../data/game-entities';
import CardThumbnail from '../CardThumbnail.astro';
import HubProminenceBadge from './HubProminenceBadge.astro';

interface Props {
	boss: BossEntity;
	image?: CardImage;
	featured?: boolean;
}

const { boss, image, featured = false } = Astro.props;
const routeLabel = boss.relatedRouteIds[0]?.replace('/mortal-shell-ii/routes/', '').replace(/\/$/, '').replaceAll('-', ' ') ?? 'Guide context';
---

<a
	class:list={[
		'exp-boss-card',
		image && 'exp-boss-card--has-image',
		!image && 'exp-boss-card--no-media',
		featured && 'exp-boss-card--featured',
	]}
	href={boss.guideUrl ?? '/'}
>
	{image && <CardThumbnail className="exp-boss-card__media" image={image.src} alt={image.alt} sizes="(min-width: 50rem) 38vw, 100vw" />}
	<div class="exp-boss-card__body">
		<div class="exp-boss-card__topline">
			<p class="exp-boss-card__kind">{boss.region} · {boss.requiredStatus}</p>
			{featured && <HubProminenceBadge prominence="hot" />}
		</div>
		<h3 class="exp-boss-card__title">{boss.name}</h3>
		<p class="exp-boss-card__description">{boss.description}</p>
		<dl class="exp-boss-card__facts">
			<div class="exp-boss-card__fact"><dt>Area</dt><dd>{boss.area}</dd></div>
			<div class="exp-boss-card__fact"><dt>Status</dt><dd>{boss.requiredStatus}</dd></div>
			<div class="exp-boss-card__fact"><dt>Route</dt><dd>{routeLabel}</dd></div>
			<div class="exp-boss-card__fact"><dt>Reward</dt><dd>{boss.reward}</dd></div>
		</dl>
		<span class="exp-boss-card__link">View Guide <span aria-hidden="true">→</span></span>
	</div>
</a>
