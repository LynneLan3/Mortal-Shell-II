---
const bosses = [
	{
		name: 'Tar Golem',
		kind: 'Boss / trophy encounter',
		area: "Disciple's Grotto · Prologue",
		description: "Take the Prologue encounter to minimum health for the missable No, You Still Can't Win trophy.",
		href: '/mortal-shell-ii/tar-golem/',
	},
	{
		name: 'Magdalena, the Lady of the Woods',
		kind: 'Boss Guide · Open Beta',
		area: 'Sunken Village · Open Beta route',
		description: 'Use the existing beta guide for the named encounter, route context, and the limits of what the preview confirms.',
		href: '/mortal-shell-ii/magdalena/',
	},
	{
		name: 'Lucian the Thirsting Knight',
		kind: 'Boss Guide',
		area: 'Hidden Keep · Stonebled Gate',
		description: 'Follow the Hidden Keep route and prepare for Lucian’s invisible second phase.',
		href: '/mortal-shell-ii/lucian-thirsting-knight/',
	},
	{
		name: 'The Lost Child',
		kind: 'Boss Guide',
		area: 'Sanguine Caverns · Fainweald',
		description: 'Reach the arena from Sanguine Shoreline Beacon and manage Digest & Excrete and Belching Breath.',
		href: '/mortal-shell-ii/lost-child/',
	},
	{
		name: 'Sariel the Endless',
		kind: 'Boss / Shell route',
		area: 'Chamber of Becoming · Silent Steps · Mammon',
		description: 'Destroy all four revival tablets before completing the Sariel route and Shell unlock.',
		href: '/mortal-shell-ii/sariel/',
	},
	{
		name: 'Vrannic the Grand Illusionist',
		kind: 'Boss Guide',
		area: 'Hall of Illusions · Mushroom Village Gate · Fainweald',
		description: 'Solve the illusion-doorway route, find Vrannic above the room, and identify the real target.',
		href: '/mortal-shell-ii/hall-of-illusions/',
	},
	{
		name: 'The Nameless Captive',
		kind: 'Boss / trophy encounter',
		optional: 'Optional trophy objective',
		description: "Use the existing Peter's Perfect Parry guide before killing the Boss if you still need the seven-hit headspin challenge.",
		href: '/mortal-shell-ii/peters-perfect-parry/',
	},
	{
		name: 'The Warden',
		kind: 'Boss / Shell route',
		area: 'Citadel of Penance',
		optional: 'Optional Shell unlock route',
		description: "Reach The Warden as part of Eredrim’s unlock route, then inhabit the Shell after the encounter.",
		href: '/mortal-shell-ii/eredrim/',
	},
	{
		name: 'Prophet of Profane Infinities',
		kind: 'Boss-linked guide',
		area: 'Obsidianite Mines · Mammon',
		description: 'Reach the end of the Obsidianite Mines route to defeat the encounter tied to the Obsidian Hammer.',
		href: '/mortal-shell-ii/obsidian-hammer/',
	},
	{
		name: 'The Hierarch',
		kind: 'Boss / Shell route',
		area: "Prophet's Rest · Outskirts of Nochte · Fainweald",
		optional: 'Optional Shell unlock route',
		description: 'Complete the three-blood-pool ritual and The Convert Memory before the Hierarch encounter.',
		href: '/mortal-shell-ii/smert/',
	},
];

const relatedRoutes = [
	{
		name: 'Smert',
		href: '/mortal-shell-ii/smert/',
		description: 'Shell unlock route linked to the Hierarch encounter at Prophet’s Rest.',
	},
	{
		name: 'Gragu',
		href: '/mortal-shell-ii/gragu/',
		description: 'Optional Shell quest route through the One-Legged Wolf Tavern and Temple of Vatra.',
	},
];
---

<section class="exp-boss-hub">
	<header class="exp-boss-hub__hero">
		<div class="exp-content">
			<p class="exp-eyebrow">Combat / Encounter Index</p>
			<h1 class="exp-h1">Mortal Shell 2 Bosses — Boss Order, Locations &amp; Guides</h1>
			<p class="exp-lede">Start with the boss and encounter guides that already exist on this site. The list is ordered by the current route coverage, not by an invented full-game progression.</p>
			<div class="exp-boss-hub__actions" aria-label="Boss guide navigation">
				<a class="exp-boss-hub__primary" href="#boss-guides">Browse boss guides</a>
				<a class="exp-boss-hub__secondary" href="/mortal-shell-ii/guides/">View all guides</a>
			</div>
		</div>
	</header>

	<div class="exp-content exp-boss-hub__body">
		<section id="boss-guides" aria-labelledby="boss-guides-heading">
			<header class="exp-boss-hub__section-head">
				<p class="exp-eyebrow">Existing coverage</p>
				<h2 class="exp-h2" id="boss-guides-heading">Bosses with a guide</h2>
				<p class="exp-lede">Every card below links to an existing guide. Region, area, and optional status appear only where the current guide supports them.</p>
			</header>
			<div class="exp-boss-grid">
				{bosses.map((boss) => (
					<article class="exp-boss-card">
						<div class="exp-boss-card__body">
							<p class="exp-boss-card__kind">{boss.kind}</p>
							<h3 class="exp-boss-card__title">{boss.name}</h3>
							<p class="exp-boss-card__description">{boss.description}</p>
							{(boss.area || boss.optional) && (
								<dl class="exp-boss-card__facts">
									{boss.area && <><dt>Region / area</dt><dd>{boss.area}</dd></>}
									{boss.optional && <><dt>Required / optional</dt><dd>{boss.optional}</dd></>}
								</dl>
							)}
							<a class="exp-boss-card__link" href={boss.href}>View Guide <span aria-hidden="true">→</span></a>
						</div>
					</article>
				))}
			</div>
		</section>

		<section class="exp-boss-hub__related" aria-labelledby="related-routes-heading">
			<header class="exp-boss-hub__section-head">
				<p class="exp-eyebrow">Related routes</p>
				<h2 class="exp-h2" id="related-routes-heading">Shell quests connected to encounters</h2>
				<p class="exp-lede">These are useful existing routes for future boss coverage, but the current pages are Shell quest guides rather than standalone Boss Guides.</p>
			</header>
			<div class="exp-related-route-grid">
				{relatedRoutes.map((route) => (
					<a class="exp-related-route" href={route.href}>
						<strong>{route.name}</strong>
						<span>{route.description}</span>
						<span class="exp-boss-card__link">View Guide <span aria-hidden="true">→</span></span>
					</a>
				))}
			</div>
		</section>

		<aside class="exp-boss-hub__future" aria-label="Future boss coverage">
			<strong>Future coverage</strong>
			<span>New bosses will be added here only after a real guide exists; this hub does not create empty pages or placeholder URLs.</span>
		</aside>
	</div>
</section>
