---

<section class="exp-boss-hub">
	<header class="exp-boss-hub__hero">
		<div class="exp-content">
			<p class="exp-eyebrow">Combat / Encounter Index</p>
			<h1 class="exp-h1">Mortal Shell 2 Bosses — Boss Order, Locations &amp; Guides</h1>
			<p class="exp-lede">Use the recommended backbone—Prologue, Fainweald gates, Mammon gates, Unfound Path guardians, then Zmey—while treating individual gate order as route-flexible. The cards below link to verified guides and label region anchors without inventing a universal numbered route.</p>
			<div class="exp-boss-hub__actions" aria-label="Boss guide navigation">
				<a class="exp-boss-hub__primary" href="#boss-guides">Browse boss guides</a>
				<a class="exp-boss-hub__secondary" href="/mortal-shell-ii/guides/">View all guides</a>
			</div>
		</div>
	</header>

	<div class="exp-content exp-boss-hub__body">
		<section id="boss-guides" aria-labelledby="boss-guides-heading">
			<header class="exp-boss-hub__section-head">
				<p class="exp-eyebrow">Existing coverage</p>
				<h2 class="exp-h2" id="boss-guides-heading">Bosses with a guide</h2>
				<p class="exp-lede">Every card below links to an existing guide. Region, area, and optional status appear only where the current guide supports them.</p>
			</header>
			<div class="exp-boss-grid">
				{bosses.map((boss) => (
					<article class="exp-boss-card">
						<div class="exp-boss-card__body">
							<p class="exp-boss-card__kind">{boss.kind}</p>
							<h3 class="exp-boss-card__title">{boss.name}</h3>
							<p class="exp-boss-card__description">{boss.description}</p>
							{(boss.area || boss.optional) && (
								<dl class="exp-boss-card__facts">
									{boss.area && <><dt>Region / area</dt><dd>{boss.area}</dd></>}
									{boss.optional && <><dt>Required / optional</dt><dd>{boss.optional}</dd></>}
								</dl>
							)}
							<a class="exp-boss-card__link" href={boss.href}>View Guide <span aria-hidden="true">→</span></a>
						</div>
					</article>
				))}
			</div>
		</section>

		<section class="exp-boss-hub__related" aria-labelledby="related-routes-heading">
			<header class="exp-boss-hub__section-head">
				<p class="exp-eyebrow">Related routes</p>
				<h2 class="exp-h2" id="related-routes-heading">Shell quests connected to encounters</h2>
				<p class="exp-lede">These are useful existing routes for future boss coverage, but the current pages are Shell quest guides rather than standalone Boss Guides.</p>
			</header>
			<div class="exp-related-route-grid">
				{relatedRoutes.map((route) => (
					<a class="exp-related-route" href={route.href}>
						<strong>{route.name}</strong>
						<span>{route.description}</span>
						<span class="exp-boss-card__link">View Guide <span aria-hidden="true">→</span></span>
					</a>
				))}
			</div>
		</section>

		<aside class="exp-boss-hub__future" aria-label="Future boss coverage">
			<strong>Future coverage</strong>
			<span>New bosses will be added here only after a real guide exists; this hub does not create empty pages or placeholder URLs.</span>
		</aside>
	</div>
</section>
