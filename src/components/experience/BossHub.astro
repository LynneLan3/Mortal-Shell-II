---
import CardThumbnail from '../CardThumbnail.astro';
import { resolveCardImage } from '../../lib/assets';
import { game } from '../../config/game';
import HubSubnav from './HubSubnav.astro';
import { getPortalProminence } from '../../lib/hub-prominence';
import HubProminenceBadge from './HubProminenceBadge.astro';
import { bossEntities } from '../../data/game-entities';
import { cardDensity, hasFeatureLast } from '../../lib/card-density';

const relatedRoutes = [
	{
		name: 'Smert',
		href: '/mortal-shell-ii/smert/',
		description: 'Shell unlock route linked to the Hierarch encounter at Prophet’s Rest.',
	},
	{
		name: 'Gragu',
		href: '/mortal-shell-ii/gragu/',
		description: 'Optional Shell quest route through the One-Legged Wolf Tavern and Temple of Vatra.',
	},
];

const bosses = bossEntities.map((entity) => ({
	...entity,
	href: entity.guideUrl ?? '/',
	kind: `${entity.progressionGroup} · ${entity.requiredStatus}`,
	optional: entity.requiredStatus === 'Required' ? undefined : entity.requiredStatus,
}));
const progressionOrder = ['Prologue', 'Fainweald', 'Mammon', 'The Unfound Path', 'Endgame / Zmey', 'Optional / Other'] as const;
const bossGroups = progressionOrder
	.map((group) => ({ group, bosses: bosses.filter((boss) => boss.progressionGroup === group).sort((a, b) => a.progressionPosition - b.progressionPosition) }))
	.filter((group) => group.bosses.length > 0);
const progressionGroups = progressionOrder.slice(0, 5);
const progressionDensity = cardDensity(progressionGroups.length, 2);
const progressionFeatureLast = hasFeatureLast(progressionGroups.length, 2);
const hotSignals = getPortalProminence(game.portal);
const bossHotHrefs = new Set(bosses.filter((boss) => hotSignals.hot.has(boss.href)).slice(0, 4).map((boss) => boss.href));
---

<section class="exp-boss-hub">
	<header class="exp-boss-hub__hero hub-scroll-target" id="overview">
		<div class="exp-content">
			<p class="exp-eyebrow">Combat / Encounter Index</p>
			<h1 class="exp-h1">Mortal Shell 2 Bosses — Boss Order, Locations &amp; Guides</h1>
			<p class="exp-lede">Use the recommended backbone—Prologue, Fainweald gates, Mammon gates, Unfound Path guardians, then Zmey—while treating individual gate order as route-flexible. The cards below link to verified guides and label region anchors without inventing a universal numbered route.</p>
		</div>
	</header>

	<HubSubnav
		items={[
			{ id: 'overview', label: 'Overview' },
			{ id: 'recommended-progression', label: 'Recommended Progression' },
			{ id: 'boss-guides', label: 'Boss Guides' },
			{ id: 'related-routes', label: 'Related Routes' },
		]}
		ariaLabel="Boss sections"
	/>

	<div class="exp-content exp-boss-hub__body">
		<section id="recommended-progression" class="exp-boss-progression hub-scroll-target" aria-labelledby="recommended-progression-heading">
			<header class="exp-boss-hub__section-head">
				<p class="exp-eyebrow">Route backbone</p>
				<h2 class="exp-h2" id="recommended-progression-heading">Recommended progression</h2>
				<p class="exp-lede">Use this as a region-first backbone rather than a mandatory numbered route: Prologue → Fainweald → Mammon → The Unfound Path → Endgame / Zmey. Optional and boss-linked encounters stay labeled instead of being presented as required gates.</p>
			</header>
			<div class:list={['exp-boss-progression__steps', `exp-boss-progression__steps--${progressionDensity}`, progressionFeatureLast && 'exp-boss-progression__steps--feature-last']}>
				{progressionGroups.map((group, index) => (
					<a class:list={['exp-boss-progression__step', progressionFeatureLast && index === progressionGroups.length - 1 && 'exp-boss-progression__step--wide']} href={`#boss-group-${group.toLowerCase().replace(/[^a-z]+/g, '-')}`}>
						<span class="exp-boss-progression__number">{String(index + 1).padStart(2, '0')}</span>
						<strong>{group}</strong>
						<span>{bossGroups.find((item) => item.group === group)?.bosses.length ?? 0} guide{(bossGroups.find((item) => item.group === group)?.bosses.length ?? 0) === 1 ? '' : 's'}</span>
					</a>
				))}
			</div>
		</section>

		<section id="boss-guides" class="hub-scroll-target" aria-labelledby="boss-guides-heading">
			<header class="exp-boss-hub__section-head">
				<p class="exp-eyebrow">Existing coverage</p>
				<h2 class="exp-h2" id="boss-guides-heading">Bosses with a guide</h2>
				<p class="exp-lede">Every card below links to an existing guide. Region, progression position, reward/outcome, and required status use the shared boss entity data; route order remains flexible where the evidence does not establish a hard gate.</p>
			</header>
			{bossGroups.map((group) => {
				const density = cardDensity(group.bosses.length, 2);
				const featureLast = hasFeatureLast(group.bosses.length, 2);
				return (
				<section id={`boss-group-${group.group.toLowerCase().replace(/[^a-z]+/g, '-')}`} class="exp-boss-group hub-scroll-target" aria-labelledby={`boss-group-${group.group.toLowerCase().replace(/[^a-z]+/g, '-')}-heading`}>
					<h3 class="exp-h3" id={`boss-group-${group.group.toLowerCase().replace(/[^a-z]+/g, '-')}-heading`}>{group.group}</h3>
					<div class:list={['exp-boss-grid', `exp-boss-grid--${density}`, featureLast && 'exp-boss-grid--feature-last']}>
						{group.bosses.map((boss, bossIndex) => {
							const image = resolveCardImage({ href: boss.href, title: boss.name });
							const isWide = featureLast && bossIndex === group.bosses.length - 1;
							return (
								<a class:list={['exp-boss-card', image && 'exp-boss-card--has-image', isWide && 'exp-boss-card--wide']} href={boss.href}>
									{image && <CardThumbnail className="exp-boss-card__media" image={image.src} alt={image.alt} />}
									<div class="exp-boss-card__body">
										<div class="exp-boss-card__topline">
											<p class="exp-boss-card__kind">{boss.kind}</p>
											{bossHotHrefs.has(boss.href) && <HubProminenceBadge prominence="hot" />}
										</div>
										<h3 class="exp-boss-card__title">{boss.name}</h3>
										<p class="exp-boss-card__description">{boss.description}</p>
										<dl class="exp-boss-card__facts">
											<div class="exp-boss-card__fact"><dt>Position</dt><dd>{boss.progressionPosition}</dd></div>
											<div class="exp-boss-card__fact"><dt>Region / area</dt><dd>{boss.area}</dd></div>
											<div class="exp-boss-card__fact"><dt>Required / optional</dt><dd>{boss.requiredStatus}</dd></div>
											<div class="exp-boss-card__fact"><dt>Reward / outcome</dt><dd>{boss.reward}</dd></div>
											<div class="exp-boss-card__fact"><dt>Related route</dt><dd>{boss.relatedRouteIds[0]?.replace('/mortal-shell-ii/routes/', '').replace(/\/$/, '').replaceAll('-', ' ') ?? 'Guide context'}</dd></div>
										</dl>
										<span class="exp-boss-card__link">View Guide <span aria-hidden="true">→</span></span>
									</div>
								</a>
							);
						})}
					</div>
				</section>
				);
			})}
		</section>

		<section id="related-routes" class="exp-boss-hub__related hub-scroll-target" aria-labelledby="related-routes-heading">
			<header class="exp-boss-hub__section-head">
				<p class="exp-eyebrow">Related routes</p>
				<h2 class="exp-h2" id="related-routes-heading">Shell quests connected to encounters</h2>
				<p class="exp-lede">These are useful existing routes for future boss coverage, but the current pages are Shell quest guides rather than standalone Boss Guides.</p>
			</header>
			<div class="exp-related-route-grid">
				{relatedRoutes.map((route) => (
					<a class="exp-related-route" href={route.href}>
						<strong>{route.name}</strong>
						<span>{route.description}</span>
						<span class="exp-boss-card__link">View Guide <span aria-hidden="true">→</span></span>
					</a>
				))}
			</div>
		</section>

		<aside class="exp-boss-hub__future" aria-label="Future boss coverage">
			<strong>Future coverage</strong>
			<span>New bosses will be added here only after a real guide exists; this hub does not create empty pages or placeholder URLs.</span>
		</aside>
	</div>
</section>
