---
import type { GameAlert } from '../../config/alerts';

interface Props {
	alert: GameAlert;
}

const { alert } = Astro.props;
---

<section class="exp-alert-strip" aria-labelledby="exp-live-update-heading">
	<div class="exp-content exp-alert-strip__inner">
		<a class="exp-alert-strip__link" href={alert.href}>
			<span class="exp-alert-strip__copy">
				<strong id="exp-live-update-heading" class="exp-alert-strip__title">{alert.title}</strong>
				<span class="exp-alert-strip__description">{alert.consequence}</span>
			</span>
		</a>
	</div>
</section>
