---
import { ui } from '../../lib/ui';
import { getGuides, guideHref, resolveRelated } from '../../lib/guides';
import CardThumbnail from '../CardThumbnail.astro';
import { resolveCardImage } from '../../lib/assets';

const { entry } = Astro.locals.starlightRoute;
const t = ui();
const relatedSlugs = entry.data.related ?? [];
const nextGuides = relatedSlugs.length > 0
	? resolveRelated(await getGuides(), relatedSlugs, entry.id).slice(0, 2)
	: [];
---

{nextGuides.length > 0 && (
	<section class="exp-next-step" aria-labelledby="exp-next-step-heading">
		<div class="exp-next-step__inner">
			<p class="exp-eyebrow">{t.nextStepGuide}</p>
			<h2 class="exp-next-step__title" id="exp-next-step-heading">{t.nextQuestions}</h2>
			<p class="exp-next-step__lede">{t.nextQuestionsLede}</p>
			<div class="exp-next-step__grid">
				{nextGuides.map((guide) => (
					<a class="exp-next-step__card" href={guideHref(guide)}>
						{(() => {
							const image = resolveCardImage({ href: guideHref(guide), title: guide.data.title, cover: guide.data.cover });
							return image && <CardThumbnail className="exp-next-step__media" image={image.src} alt={image.alt} />;
						})()}
						<span class="exp-next-step__card-title">{guide.data.title}</span>
						{guide.data.description && <span class="exp-next-step__card-desc">{guide.data.description}</span>}
						<span class="exp-cta-link">{t.readGuide}</span>
					</a>
				))}
			</div>
		</div>
	</section>
)}
