---
/**
 * Formal Experience Homepage (V2.2-E1) — rendered at `/{hubPath}/`.
 *
 * Replaces the legacy GamePortal presentation on the splash entry. Every
 * section is data-driven from existing runtime config (`game`, `game.routes`,
 * `game.portal`) and the existing docs content collection. No new Homepage
 * schema. Sections are omitted (never placeholder-filled) when their data is
 * absent.
 *
 * Section order:
 *   Hero → Core Guide Hubs → Live Update / Don't Miss → Beginner →
 *   Popular Guides → Recommended Routes → Popular Questions → Recently
 *   Updated → Field Notes → Evidence → About.
 */
import { Image } from 'astro:assets';
import { game } from '../../config/game';
import { getDontMissAlerts, getLiveUpdateAlert } from '../../config/alerts';
import { resolveCardImage, resolveEntryCardImage, resolveGameAsset, sortCardsByImage } from '../../lib/assets';
import CardThumbnail from '../CardThumbnail.astro';
import { getGuides, guideHref, categoryOf } from '../../lib/guides';
import {
	deriveRecentViews,
	fieldNotesFrom,
	hasGuideCover,
	orderGoalRoutes,
} from '../../lib/experience-homepage';
import { experienceNav } from '../../lib/experience-nav';
import {
	formatReleaseDateValue,
	formatReleaseFact,
	formatUiDate,
	releaseStatusLabel,
	ui,
} from '../../lib/ui';
import ExperienceRouteShowcase from './ExperienceRouteShowcase.astro';
import RouteTopicCard from './routes/RouteTopicCard.astro';
import AuthorityHubGrid from './AuthorityHubGrid.astro';
import ExperienceAlertStrip from './ExperienceAlertStrip.astro';
import ExperienceDontMiss from './ExperienceDontMiss.astro';
import { cardDensity, hasFeatureLast } from '../../lib/card-density';

const t = ui();
const guides = await getGuides();
const { guidesHref } = experienceNav();

/* ── Hero ── */
const heroImage = resolveGameAsset(game.heroImage, 'game.heroImage');
const heroPosition = game.heroPosition ?? 'center';

/* ── Start Here ── */
type StartHereView = {
	title: string;
	description: string;
	href: string;
	image?: string;
	imageAlt?: string;
	label?: string;
	badge?: string;
};

const configuredStartHere = game.portal?.startHere;
const startHere: StartHereView[] = configuredStartHere?.length
	? configuredStartHere.slice(0, 4).map((item) => ({
			title: item.title,
			description: item.description,
			href: item.href,
			image: item.image,
			imageAlt: item.imageAlt,
			label: item.label,
			badge: item.badge,
		}))
		: [];

/* ── Hot Launch Guides ── */
const configuredHotGuides = game.portal?.hotGuides;
const hotGuides: StartHereView[] = configuredHotGuides?.length
	? configuredHotGuides.slice(0, 6).map((item) => ({
			title: item.title,
			description: item.description,
			href: item.href,
			image: item.image,
			imageAlt: item.imageAlt,
			label: item.label,
			badge: item.badge,
		}))
	: [];
const authorityHubs = game.portal?.authorityHubs ?? [];
const beginnerGuide = guides.find((entry) => guideHref(entry) === '/mortal-shell-ii/beginner-guide/');
const beginnerHub = authorityHubs.find((hub) => hub.href === '/mortal-shell-ii/beginner-guide/');
const beginnerSection = game.portal?.homepageSections?.['beginner-start'];
const hotGuidesSection = game.portal?.homepageSections?.['hot-guides'];
const liveUpdateAlert = getLiveUpdateAlert();
const dontMissAlerts = getDontMissAlerts();
const orderedHotGuides = sortCardsByImage(hotGuides, (item) => resolveCardImage({ href: item.href, title: item.title, image: item.image, imageAlt: item.imageAlt }));

/* ── Hero CTAs ── */
const configuredPrimary = game.portal?.primaryCta;
const primaryCta =
	configuredPrimary
		? { label: configuredPrimary.label, href: configuredPrimary.href }
		: startHere[0]
			? { label: configuredPrimary?.label ?? t.startHere, href: startHere[0].href }
			: undefined;
const configuredSecondary = game.portal?.secondaryCta;
const secondaryCta =
	configuredSecondary && !configuredSecondary.href.startsWith('#')
		? { label: configuredSecondary.label, href: configuredSecondary.href }
		: { label: configuredSecondary?.label ?? t.browseGuides, href: guidesHref };

/* ── Status Strip ── */
const curatedRecent = game.portal?.recentUpdates;
const showRecentlyUpdated = game.portal?.showRecentlyUpdated !== false;
const maxRecent = Math.min(game.portal?.maxRecent ?? 3, 4);
const recentlyUpdated = !showRecentlyUpdated
	? []
	: curatedRecent?.length
		? curatedRecent.slice(0, maxRecent).map((item) => ({
				title: item.title,
				href: item.href,
				date: new Date(item.date),
				changeSummary: item.changeSummary,
				tag: item.tag,
			}))
		: deriveRecentViews(guides, maxRecent);

const configuredStatus = game.portal?.statusItems;
const derivedStatus = [
	{
		label: releaseStatusLabel(game.releaseStatus),
		value: formatReleaseDateValue(game.releaseDate) ?? '',
	},
	{ label: t.platforms, value: game.platforms.filter(Boolean).join(' / ') },
	{ label: t.developer, value: game.developer },
	recentlyUpdated[0]
		? { label: t.updated, value: formatUiDate(recentlyUpdated[0].date) }
		: { label: t.updated, value: '' },
];
const statusItems = (
	configuredStatus
		? configuredStatus.map((item) => ({ label: item.label, value: item.value }))
		: derivedStatus
)
	.filter((item) => item.label.trim() && item.value.trim())
	.slice(0, 4);

/* ── Choose Your Route ── */
const routes = orderGoalRoutes(game.routes ?? []);
const singleRoute = routes.length === 1 ? routes[0] : undefined;
const singleRouteStartGuides = singleRoute?.pages ?? [];

/* ── Popular Questions ── */
const popularQuestions = game.portal?.popularQuestions ?? [];
const orderedPopularQuestions = sortCardsByImage(popularQuestions, (question) => resolveCardImage({ href: question.href, title: question.label }));

/* ── Field Notes ── */
const startHereHrefs = new Set(startHere.map((item) => item.href));
const hotGuideHrefs = new Set(hotGuides.map((item) => item.href));
const fieldNoteOrder = game.portal?.fieldNoteOrder ?? [];
const curatedFieldNotes = fieldNoteOrder
	.map((href) => guides.find((entry) => guideHref(entry) === href))
	.filter((entry): entry is (typeof guides)[number] => Boolean(entry))
	.filter((entry) => !hotGuideHrefs.has(guideHref(entry)))
	.slice(0, 3);
const fieldNotes = curatedFieldNotes.length > 0
	? curatedFieldNotes
	: fieldNotesFrom(guides, {
			excludeHrefs: new Set([...startHereHrefs, ...hotGuideHrefs]),
			limit: 3,
		});
const orderedFieldNotes = sortCardsByImage(fieldNotes, (entry) => resolveEntryCardImage(entry, guideHref(entry)));
const firstNoteWithCover = orderedFieldNotes.find((entry) => Boolean(resolveEntryCardImage(entry, guideHref(entry))) || hasGuideCover(entry));
const fieldNotesDensity = cardDensity(orderedFieldNotes.length, 3);
const fieldNotesFeatureLast = hasFeatureLast(orderedFieldNotes.length, 3);

/* ── Evidence ── */
const evidenceConfig = game.portal?.evidence;
const evidenceItems =
	evidenceConfig?.items.flatMap((item, index) => {
		const image = resolveGameAsset(item.image, `game.portal.evidence.items[${index}].image`);
		if (!image) return [];
		return { image, alt: item.alt, caption: item.caption, href: item.href };
	}) ?? [];

const showAbout = game.portal?.showAbout !== false;

type IconName = 'book' | 'calendar' | 'clock' | 'compass' | 'flag' | 'help' | 'monitor' | 'play' | 'sword';

const iconPaths: Record<IconName, string> = {
	book: '<path d="M4.5 3.5h5a2 2 0 0 1 2 2v10a2 2 0 0 0-2-2h-5z"/><path d="M19.5 3.5h-5a2 2 0 0 0-2 2v10a2 2 0 0 1 2-2h5z"/>',
	calendar: '<rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M8 3.5v3"/><path d="M16 3.5v3"/><path d="M3.5 9h17"/>',
	clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5v5l3.5 2"/>',
	compass: '<circle cx="12" cy="12" r="8.5"/><path d="m15.5 8.5-2.2 5-5 2.2 2.2-5z"/>',
	flag: '<path d="M5 20V4"/><path d="M5 4h10l-.8 4L17 12H5"/>',
	help: '<circle cx="12" cy="12" r="8.5"/><path d="M9.8 9.7a2.4 2.4 0 0 1 4.6 1c0 1.8-2.4 2-2.4 3.8"/><path d="M12 17.4h.01"/>',
	monitor: '<rect x="3.5" y="5" width="17" height="12" rx="2"/><path d="M9 20h6"/><path d="M12 17v3"/>',
	play: '<path d="M8 5.5v13l10-6.5z"/>',
	sword: '<path d="M14.5 4.5 19.5 2 17 7l-8.5 8.5-2-2z"/><path d="m6.5 13.5 4 4"/><path d="m4 20 3.5-3.5"/>',
};

const startIcon = (title: string): IconName => {
	const normalized = title.toLowerCase();
	if (normalized.includes('weapon')) return 'sword';
	if (normalized.includes('world')) return 'compass';
	if (normalized.includes('pc')) return 'monitor';
	return 'flag';
};

const factIcon = (label: string): IconName => {
	const normalized = label.toLowerCase();
	if (normalized.includes('platform')) return 'monitor';
	if (normalized.includes('developer') || normalized.includes('publisher')) return 'book';
	if (normalized.includes('updated')) return 'clock';
	return 'calendar';
};
---

<!-- 01 HERO -->
<section class:list={['exp-home-hero', heroImage && 'exp-home-hero--media']}>
	{heroImage && (
		<div class="exp-home-hero__visual">
			<Image
				src={heroImage}
				alt={game.heroAlt ?? game.name}
				width={1920}
				height={620}
				widths={[640, 960, 1280, 1920]}
				sizes="(max-width: 768px) 100vw, 1280px"
				loading="eager"
				fetchpriority="high"
				decoding="async"
				format="webp"
				quality={72}
				style={{ objectPosition: heroPosition }}
			/>
		</div>
	)}
	<div class="exp-home-hero__content">
		<div class="exp-home-hero__copy">
			<h1 class="exp-display exp-home-hero__title">{game.hubTitle ?? `${game.name} Guide & Wiki`}</h1>
		<p class="exp-lede exp-home-hero__tagline">{game.tagline}</p>
		<div class="exp-home-hero__actions">
			{primaryCta && (
				<a class="exp-btn exp-btn--primary" href={primaryCta.href}>
					{primaryCta.label}
				</a>
			)}
			{secondaryCta && (
				<a class="exp-btn exp-btn--ghost" href={secondaryCta.href}>
					{secondaryCta.label}
				</a>
			)}
		</div>
	</div>
		</div>
	</section>

	<!-- 02 CORE GUIDE HUBS -->
	{authorityHubs.length > 0 && (
		<section class="exp-section exp-home-authority" id="core-guide-hubs" aria-labelledby="exp-home-authority-heading">
			<div class="exp-content">
				<h2 class="exp-h2" id="exp-home-authority-heading">{game.portal?.authoritySectionTitle ?? 'Core Guide Hubs'}</h2>
				{game.portal?.authoritySectionDescription && <p class="exp-lede">{game.portal.authoritySectionDescription}</p>}
				<AuthorityHubGrid hubs={authorityHubs} />
			</div>
		</section>
	)}

	<!-- 03 DON'T MISS / LIVE UPDATE -->
	{liveUpdateAlert && <ExperienceAlertStrip alert={liveUpdateAlert} />}
	{statusItems.length > 0 && (
	<dl class="exp-home-status" aria-label={t.gameFacts}>
		{statusItems.map((item) => (
			<div class="exp-home-status__item">
				<dt>{item.label}</dt>
				<dd>{item.value}</dd>
			</div>
		))}
	</dl>
)}

	{dontMissAlerts.length > 0 && <ExperienceDontMiss alerts={dontMissAlerts} />}

	<div class="exp-home-flow">
		<!-- 04 BEGINNER / START YOUR RUN -->
		{beginnerGuide && beginnerHub && (
			<section class="exp-section exp-home-beginner" id="beginner-guide" aria-labelledby="exp-home-beginner-heading">
				<div class="exp-content">
					<h2 class="exp-h2" id="exp-home-beginner-heading">{beginnerSection?.title ?? beginnerGuide.data.title}</h2>
					<p class="exp-lede">{beginnerSection?.description ?? beginnerGuide.data.description}</p>
					<AuthorityHubGrid hubs={[beginnerHub]} />
				</div>
			</section>
		)}

		<!-- 05 HOT / POPULAR GUIDES -->
		{orderedHotGuides.length > 0 && (
			<section class="exp-section exp-home-hot" id="hot-guides" aria-labelledby="exp-home-hot-heading">
				<div class="exp-content">
					<h2 class="exp-h2" id="exp-home-hot-heading">{hotGuidesSection?.title ?? 'Hot Launch Guides'}</h2>
					<p class="exp-lede">{hotGuidesSection?.description ?? 'Start with the current progression blockers, unlock routes, and endgame questions players are most likely to hit after launch.'}</p>
				<div class="exp-hot-grid">
					{orderedHotGuides.map((item, index) => (
						<a class="exp-hot-card" href={item.href}>
							{(() => {
								const image = resolveCardImage({ href: item.href, title: item.title, image: item.image, imageAlt: item.imageAlt });
								return image && <CardThumbnail className="exp-hot-card__thumbnail" image={image.src} alt={image.alt} />;
							})()}
							<div class="exp-hot-card__meta">
								<span class="exp-hot-card__number">{String(index + 1).padStart(2, '0')}</span>
								<span class="exp-hot-card__badge">{item.badge ?? 'Guide'}</span>
							</div>
							<span class="exp-hot-card__title">{item.title}</span>
							<span class="exp-hot-card__desc">{item.description}</span>
							<span class="exp-hot-card__cta">Read guide <span aria-hidden="true">→</span></span>
						</a>
					))}
				</div>
			</div>
		</section>
		)}

		<!-- 06 RECOMMENDED ROUTES -->
		{routes.length > 1 && <ExperienceRouteShowcase routes={routes} />}

	{singleRoute && (
		<section class="exp-section exp-home-primary-path" aria-labelledby="exp-home-primary-path-heading">
			<div class="exp-content">
				<p class="exp-eyebrow">{t.startHere}</p>
				<h2 class="exp-h2" id="exp-home-primary-path-heading">{singleRoute.title}</h2>
				<p class="exp-lede">{singleRoute.description}</p>
				<div class="exp-primary-path">
					<RouteTopicCard route={singleRoute} number="01" variant="primary" />
					{singleRouteStartGuides.length > 0 && (
						<div class="exp-primary-path__guides" aria-label={t.followTheRoute}>
							{singleRouteStartGuides.map((page) => (
								<a class="exp-primary-guide" href={page.href}>
									<span class="exp-primary-guide__label">{page.eyebrow ?? t.read}</span>
									<span class="exp-primary-guide__title">{page.title}</span>
									<span class="exp-primary-guide__desc">{page.description}</span>
									<span class="exp-primary-guide__arrow" aria-hidden="true">→</span>
								</a>
							))}
						</div>
					)}
				</div>
			</div>
		</section>
	)}

	<!-- 06 POPULAR QUESTIONS -->
	{popularQuestions.length > 0 && (
		<section class="exp-section exp-section--tinted exp-home-questions" aria-labelledby="exp-home-questions-heading">
			<div class="exp-content">
				<p class="exp-eyebrow">{t.popularQuestions}</p>
				<h2 class="exp-h2" id="exp-home-questions-heading">{t.popularQuestions}</h2>
				<p class="exp-lede">{t.popularQuestionsLede}</p>
				<div class="exp-questions">
				{orderedPopularQuestions.map((question) => (
						<a class="exp-question" href={question.href}>
							{(() => {
								const image = resolveCardImage({ href: question.href, title: question.label });
								return image && <CardThumbnail className="exp-question__thumbnail" image={image.src} alt={image.alt} />;
							})()}
							<svg class="exp-inline-icon exp-question__icon" aria-hidden="true" viewBox="0 0 24 24">
								<Fragment set:html={iconPaths.help} />
							</svg>
							<span class="exp-question__copy">
								<span class="exp-question__title">{question.label}</span>
								{question.context && <span class="exp-question__context">{question.context}</span>}
							</span>
							<span class="exp-question__cta">{t.readGuide}</span>
						</a>
					))}
				</div>
			</div>
		</section>
	)}

	<!-- 07 RECENTLY UPDATED -->
	{recentlyUpdated.length > 0 && (
	<section class="exp-section exp-home-recent" aria-labelledby="exp-home-recent-heading">
		<div class="exp-content">
			<p class="exp-eyebrow">{t.recentlyUpdated}</p>
			<h2 class="exp-h2" id="exp-home-recent-heading">{t.recentlyUpdated}</h2>
			<p class="exp-lede">{t.recentlyUpdatedLede}</p>
			<ul class="exp-recent">
				{recentlyUpdated.map((item) => (
					<li>
						<a class="exp-recent__row" href={item.href}>
							<span class="exp-recent__main">
								<span class="exp-recent__title">
									<svg class="exp-inline-icon exp-recent__icon" aria-hidden="true" viewBox="0 0 24 24">
										<Fragment set:html={iconPaths.clock} />
									</svg>
									{item.title}
								</span>
								{item.changeSummary && <span class="exp-recent__change">{item.changeSummary}</span>}
							</span>
							<time class="exp-recent__date" datetime={item.date.toISOString()}>
								{formatUiDate(item.date)}
							</time>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>
	)}

	<!-- 09 FIELD NOTES -->
	{orderedFieldNotes.length > 0 && (
	<section class="exp-section exp-section--tinted exp-home-notes" aria-labelledby="exp-home-notes-heading">
		<div class="exp-content">
			<p class="exp-eyebrow">{t.fieldNotes}</p>
			<h2 class="exp-h2" id="exp-home-notes-heading">{t.moreToExplore}</h2>
			<p class="exp-lede">{t.fieldNotesLede}</p>
			<div class:list={['exp-field-notes', !firstNoteWithCover && 'exp-field-notes--text', `exp-field-notes--density-${fieldNotesDensity}`, fieldNotesFeatureLast && 'exp-field-notes--feature-last']}>
				{orderedFieldNotes.map((note, noteIndex) => {
					const href = guideHref(note);
					return (
						<a
							class:list={[
								'exp-field-card',
								note === firstNoteWithCover && 'exp-field-card--primary',
								fieldNotesFeatureLast && noteIndex === orderedFieldNotes.length - 1 && 'exp-field-card--wide',
							]}
							href={href}
						>
							{(() => {
								const image = resolveEntryCardImage(note, href);
								return image && (
									<CardThumbnail className="exp-field-card__visual" image={image.src} alt={image.alt} sizes="(min-width: 50rem) 40vw, 100vw" />
								);
							})()}
							<span class="exp-field-card__eyebrow">
								<svg class="exp-inline-icon" aria-hidden="true" viewBox="0 0 24 24">
									<Fragment set:html={iconPaths.book} />
								</svg>
								{note.data.eyebrow ?? categoryOf(note)?.label ?? t.fieldNotes}
							</span>
							<span class="exp-field-card__title">{note.data.title}</span>
							{note.data.description && (
								<span class="exp-field-card__desc">{note.data.description}</span>
							)}
							<span class="exp-cta-link exp-field-card__cta">{t.readGuide}</span>
						</a>
					);
				})}
			</div>
		</div>
	</section>
	)}

	<!-- 09 EVIDENCE -->
	{evidenceItems.length > 0 && (
	<section class="exp-section exp-section--dark exp-home-evidence" aria-labelledby="exp-home-evidence-heading">
		<div class="exp-content">
			<p class="exp-eyebrow">{t.seeGameInAction}</p>
			<h2 class="exp-h2" id="exp-home-evidence-heading">{evidenceConfig?.title ?? t.seeGameInAction}</h2>
			{evidenceConfig?.description && <p class="exp-lede">{evidenceConfig.description}</p>}
			<div class="exp-evidence">
				{evidenceItems.map((item) =>
					item.href ? (
						<a class="exp-evidence__frame" href={item.href}>
							<Image
								src={item.image}
								alt={item.alt}
								width={800}
								height={450}
								sizes="(min-width: 50rem) 32vw, 100vw"
								loading="lazy"
							/>
							{item.caption && <span class="exp-evidence__caption">{item.caption}</span>}
						</a>
					) : (
						<figure class="exp-evidence__frame">
							<Image
								src={item.image}
								alt={item.alt}
								width={800}
								height={450}
								sizes="(min-width: 50rem) 32vw, 100vw"
								loading="lazy"
							/>
							{item.caption && <figcaption class="exp-evidence__caption">{item.caption}</figcaption>}
						</figure>
					),
				)}
			</div>
		</div>
	</section>
	)}

	<!-- 10 ABOUT -->
	{showAbout && (
	<section class="exp-section exp-home-about" id="about" aria-labelledby="exp-home-about-heading">
		<div class="exp-content">
			<p class="exp-eyebrow">{t.aboutGame(game.name)}</p>
			<h2 class="exp-h2" id="exp-home-about-heading">{t.aboutGame(game.name)}</h2>
			<p class="exp-lede exp-home-about__desc">{game.description}</p>
			{game.disclaimer && <p class="exp-home-about__disclaimer">{game.disclaimer}</p>}
			<dl class="exp-facts-strip exp-home-about__facts">
				<div class="exp-facts-strip__item">
					<dt>
						<svg class="exp-inline-icon" aria-hidden="true" viewBox="0 0 24 24">
							<Fragment set:html={iconPaths[factIcon(t.releaseStatus)]} />
						</svg>
						{t.releaseStatus}
					</dt>
					<dd>{formatReleaseFact(game.releaseStatus, game.releaseDate)}</dd>
				</div>
				<div class="exp-facts-strip__item">
					<dt>
						<svg class="exp-inline-icon" aria-hidden="true" viewBox="0 0 24 24">
							<Fragment set:html={iconPaths[factIcon(t.developer)]} />
						</svg>
						{t.developer}
					</dt>
					<dd>{game.developer}</dd>
				</div>
				<div class="exp-facts-strip__item">
					<dt>
						<svg class="exp-inline-icon" aria-hidden="true" viewBox="0 0 24 24">
							<Fragment set:html={iconPaths[factIcon(t.publisher)]} />
						</svg>
						{t.publisher}
					</dt>
					<dd>{game.publisher}</dd>
				</div>
				<div class="exp-facts-strip__item">
					<dt>
						<svg class="exp-inline-icon" aria-hidden="true" viewBox="0 0 24 24">
							<Fragment set:html={iconPaths[factIcon(t.platforms)]} />
						</svg>
						{t.platforms}
					</dt>
					<dd>{game.platforms.join(' · ')}</dd>
				</div>
			</dl>
		</div>
	</section>
	)}
</div>
