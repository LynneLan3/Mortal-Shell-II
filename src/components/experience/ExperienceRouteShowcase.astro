---
/**
 * ExperienceRouteShowcase — homepage "Recommended Routes" section (V2.2-E1).
 *
 * Consumes `game.routes` only. Route numbers are derived from array index
 * (`01`, `02`, …). `route.visual` is optional: when absent a content-only
 * variant renders (no image, no placeholder, no broken-image state). The
 * Renders only the homepage multi-route picker. Single-route homepages merge
 * route + Start Here in ExperienceHomepage instead of pretending there is a
 * choice to make.
 */
import type { GameRoute } from '../../config/game';
import { game } from '../../config/game';
import { routeNumber } from '../../lib/experience-homepage';
import { ui } from '../../lib/ui';
import RouteTopicCard from './routes/RouteTopicCard.astro';

interface Props {
	routes: readonly GameRoute[];
}

const { routes } = Astro.props;
const t = ui();
const shownRoutes = routes;
const sectionCopy = game.portal?.homepageSections?.['recommended-routes'];
const sectionTitle = sectionCopy?.title ?? t.routesNav;
const sectionNavLabel = sectionCopy?.navLabel ?? sectionTitle;
---

<section class="exp-section exp-home-routes" id="recommended-routes" aria-labelledby="exp-home-routes-heading">
	<div class="exp-content">
		<p class="exp-eyebrow">{sectionNavLabel}</p>
		<h2 class="exp-h2" id="exp-home-routes-heading">{sectionTitle}</h2>
		{sectionCopy?.description
			? <p class="exp-lede">{sectionCopy.description}</p>
			: <p class="exp-lede">{t.routeGroupsLede}</p>}
	</div>
		<div class="exp-content">
			<div class="exp-routes">
			{shownRoutes.map((route, index) => (
				<RouteTopicCard route={route} number={routeNumber(index)} />
			))}
			</div>
			<a class="exp-home-routes__product-link" href="/mortal-shell-ii/routes/">Need an ordered map run? Explore Routes <span aria-hidden="true">→</span></a>
		</div>
</section>
