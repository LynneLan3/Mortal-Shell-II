---
/**
 * GameShellTopbar — reusable top bar + mobile nav + Pagefind search overlay.
 *
 * A body-level fragment (no `<html>`/`<body>` wrapper) so it can be embedded
 * either in `GameShell` or inside the Starlight shell on Experience Guide pages.
 */
import type { NavItem } from './GameShell.astro';
import { game } from '../../config/game';
import { getGuides, guideHref } from '../../lib/guides';

interface Props {
	siteTitle: string;
	homeHref: string;
	nav: NavItem[];
	activePath?: string;
}

const { siteTitle, homeHref, nav, activePath = '' } = Astro.props;

const localSearchData = (await getGuides()).map((entry) => ({
	title: entry.data.title,
	description: entry.data.description ?? '',
	href: guideHref(entry),
	text: [entry.data.title, entry.data.description, entry.data.quickAnswer, entry.body]
		.filter(Boolean)
		.join(' ')
		.replace(/\s+/g, ' ')
		.slice(0, 5000),
}));
const localSearchJson = JSON.stringify(localSearchData).replace(/</g, '\\u003c');
const isDev = import.meta.env.DEV;
const searchShortcuts = [
	...(game.portal?.hotGuides ?? []).slice(0, 3).map((item) => ({ title: item.title, href: item.href })),
	...nav
		.filter((item) => /bosses|route|map/i.test(item.label))
		.map((item) => ({ title: item.label, href: item.href })),
];

function isActive(item: NavItem): boolean {
	if (!activePath) return false;
	const clean = activePath.replace(/\/+$/, '');
	if (clean === item.href.replace(/\/+$/, '')) return true;
	return (item.activeMatch ?? []).some((prefix) => {
		const p = prefix.replace(/\/+$/, '');
		return clean === p || clean.startsWith(`${p}/`);
	});
}
---

<header class="exp-topbar">
	<div class="exp-topbar__inner">
		<a class="exp-topbar__brand" href={homeHref}>
			{siteTitle}
		</a>
		<div class="exp-topbar__actions">
			<nav class="exp-topbar__nav" aria-label="Main navigation">
				{nav.map((item) => (
					<a
						class:list={['exp-topbar__link', isActive(item) && 'is-active']}
						href={item.href}
						data-exp-nav-link
						data-exp-nav-home={item.href === homeHref ? 'true' : undefined}
						data-exp-nav-hot={item.href.endsWith('#hot-guides') ? 'true' : undefined}
						data-exp-nav-recommended-routes={item.href.endsWith('#recommended-routes') ? 'true' : undefined}
						data-exp-nav-server-active={isActive(item) ? 'true' : 'false'}
						aria-current={isActive(item) ? 'page' : undefined}
					>
						{item.label}
					</a>
				))}
				<button
					class="exp-topbar__search-trigger"
					type="button"
					aria-label="Search"
					data-exp-search-open
				>
					Search <kbd>/</kbd>
				</button>
			</nav>
			<button
				class="exp-topbar__mobile-search"
				type="button"
				aria-label="Search"
				data-exp-search-open
			>
				<span aria-hidden="true">⌕</span> Search
			</button>
			<button
				class="exp-topbar__mobile-toggle"
				type="button"
				aria-label="Menu"
				aria-expanded="false"
				data-exp-mobile-toggle
			>
				<span aria-hidden="true">☰</span>
			</button>
		</div>
	</div>
</header>
<nav class="exp-mobile-nav" aria-label="Mobile navigation" aria-hidden="true" data-exp-mobile-nav>
	{nav.map((item) => (
		<a
			class:list={['exp-topbar__link', isActive(item) && 'is-active']}
			href={item.href}
			data-exp-nav-link
			data-exp-nav-home={item.href === homeHref ? 'true' : undefined}
			data-exp-nav-hot={item.href.endsWith('#hot-guides') ? 'true' : undefined}
			data-exp-nav-recommended-routes={item.href.endsWith('#recommended-routes') ? 'true' : undefined}
			data-exp-nav-server-active={isActive(item) ? 'true' : 'false'}
			aria-current={isActive(item) ? 'page' : undefined}
		>
			{item.label}
		</a>
	))}
</nav>

{/* Search overlay (Pagefind) */}
<div class="exp-search-overlay" data-exp-search-overlay data-exp-search-dev={isDev ? 'true' : 'false'}>
	<div class="exp-search-dialog" data-exp-search-dialog role="dialog" aria-modal="true" aria-label="Search Mortal Shell II">
		<div class="exp-search-dialog__header">
			<p class="exp-search-dialog__title">Search Mortal Shell II</p>
			<button class="exp-search-dialog__close" type="button" aria-label="Close search" data-exp-search-close>Close</button>
		</div>
		<div id="exp-pagefind-container"></div>
		{searchShortcuts.length > 0 && (
			<div class="exp-search-shortcuts" data-exp-search-shortcuts>
				<p class="exp-search-shortcuts__label">Popular searches</p>
				<div class="exp-search-shortcuts__links">
					{searchShortcuts.map((item) => <a href={item.href}>{item.title}</a>)}
				</div>
			</div>
		)}
	</div>
</div>
<script type="application/json" data-exp-search-data set:html={localSearchJson}></script>

<script is:inline>
	(function () {
		function syncHashNav() {
			var homeLink = document.querySelector('[data-exp-nav-home]');
			var hotLinks = document.querySelectorAll('[data-exp-nav-hot]');
			var recommendedRoutesLinks = document.querySelectorAll('[data-exp-nav-recommended-routes]');
			var homeLinks = document.querySelectorAll('[data-exp-nav-home]');
			if (!homeLink) return;

			var currentPath = window.location.pathname.replace(/\/+$/, '') || '/';
			var homePath = new URL(homeLink.href, window.location.origin).pathname.replace(/\/+$/, '') || '/';
			var hotActive = currentPath === homePath && window.location.hash === '#hot-guides';
			var recommendedRoutesActive = currentPath === homePath && window.location.hash === '#recommended-routes';

			hotLinks.forEach(function (link) {
				link.classList.toggle('is-active', hotActive);
				if (hotActive) link.setAttribute('aria-current', 'page');
				else link.removeAttribute('aria-current');
			});
			recommendedRoutesLinks.forEach(function (link) {
				var serverActive = link.getAttribute('data-exp-nav-server-active') === 'true';
				var active = recommendedRoutesActive || (serverActive && !hotActive);
				link.classList.toggle('is-active', active);
				if (active) link.setAttribute('aria-current', 'page');
				else link.removeAttribute('aria-current');
			});
			homeLinks.forEach(function (link) {
				var serverActive = link.getAttribute('data-exp-nav-server-active') === 'true';
				var active = serverActive && !hotActive && !recommendedRoutesActive;
				link.classList.toggle('is-active', active);
				if (active) link.setAttribute('aria-current', 'page');
				else link.removeAttribute('aria-current');
			});
		}

		syncHashNav();
		window.addEventListener('hashchange', syncHashNav);

		var toggle = document.querySelector('[data-exp-mobile-toggle]');
		var mobileNav = document.querySelector('[data-exp-mobile-nav]');
		function closeMobileNav() {
			if (!mobileNav || !toggle) return;
			mobileNav.setAttribute('data-open', 'false');
			mobileNav.setAttribute('aria-hidden', 'true');
			toggle.setAttribute('aria-expanded', 'false');
		}
		function openMobileNav() {
			if (!mobileNav || !toggle) return;
			mobileNav.setAttribute('data-open', 'true');
			mobileNav.setAttribute('aria-hidden', 'false');
			toggle.setAttribute('aria-expanded', 'true');
		}
		if (toggle && mobileNav) {
			toggle.addEventListener('click', function () {
				var open = mobileNav.getAttribute('data-open') === 'true';
				if (open) closeMobileNav();
				else openMobileNav();
			});
			mobileNav.querySelectorAll('a').forEach(function (link) {
				link.addEventListener('click', closeMobileNav);
			});
		}

		var overlay = document.querySelector('[data-exp-search-overlay]');
		var triggers = document.querySelectorAll('[data-exp-search-open]');
		var pfInit = false;
		var localSearchData = [];
		var localSearchDataNode = document.querySelector('[data-exp-search-data]');
		if (localSearchDataNode) {
			try {
				localSearchData = JSON.parse(localSearchDataNode.textContent || '[]');
			} catch (error) {
				localSearchData = [];
			}
		}

		function showLocalSearch() {
			var container = document.querySelector('#exp-pagefind-container');
			if (!container) return;
			container.innerHTML = '';

			var label = document.createElement('label');
			label.className = 'exp-local-search__label';
			label.textContent = 'Search the Mortal Shell II guides';
			var input = document.createElement('input');
			input.className = 'exp-local-search__input';
			input.type = 'search';
			input.placeholder = 'Search weapons, Shells, Ova, NG+...';
			input.setAttribute('aria-label', 'Search the Mortal Shell II guides');
			label.appendChild(input);
			var message = document.createElement('p');
			message.className = 'exp-local-search__message';
			var results = document.createElement('div');
			results.className = 'exp-local-search__results';
			container.appendChild(label);
			container.appendChild(message);
			container.appendChild(results);

			function renderResults() {
				var query = input.value.trim().toLowerCase();
				var shortcuts = document.querySelector('[data-exp-search-shortcuts]');
				if (shortcuts) shortcuts.toggleAttribute('hidden', Boolean(query));
				results.innerHTML = '';
				if (!query) {
					message.textContent = 'Search the guide library or choose a popular guide.';
					return;
				}

				var terms = query.split(/\s+/).filter(Boolean);
				var matches = localSearchData
					.filter(function (entry) {
						var haystack = (entry.text || '').toLowerCase();
						return terms.every(function (term) { return haystack.includes(term); });
					})
					.map(function (entry) {
						var title = (entry.title || '').toLowerCase();
						var description = (entry.description || '').toLowerCase();
						var score = terms.reduce(function (total, term) {
							return total + (title.includes(term) ? 10 : 0) + (description.includes(term) ? 3 : 0);
						}, 0);
						return { entry: entry, score: score };
					})
					.sort(function (a, b) { return b.score - a.score; })
					.slice(0, 8)
					.map(function (item) { return item.entry; });

				message.textContent = matches.length
					? matches.length + (matches.length === 1 ? ' result' : ' results')
					: 'No matching guides yet.';
				matches.forEach(function (entry) {
					var article = document.createElement('article');
					article.className = 'exp-local-search__result';
					var link = document.createElement('a');
					link.href = entry.href;
					link.className = 'exp-local-search__title';
					link.textContent = entry.title;
					var description = document.createElement('p');
					description.textContent = entry.description || '';
					article.appendChild(link);
					article.appendChild(description);
					results.appendChild(article);
				});
			}

			input.addEventListener('input', renderResults);
			input.focus();
			renderResults();
		}

		function syncSearchShortcuts(input) {
			var shortcuts = document.querySelector('[data-exp-search-shortcuts]');
			if (!shortcuts || !input || input.getAttribute('data-shortcuts-bound') === 'true') return;
			input.setAttribute('data-shortcuts-bound', 'true');
			input.addEventListener('input', function () {
				shortcuts.toggleAttribute('hidden', Boolean(input.value.trim()));
			});
		}

		function openSearch() {
			if (!overlay) return;
			closeMobileNav();
			overlay.setAttribute('data-open', 'true');
			if (!pfInit) {
				pfInit = true;
				if (overlay.getAttribute('data-exp-search-dev') === 'true') {
					showLocalSearch();
					return;
				}
				var script = document.createElement('script');
				script.src = '/pagefind/pagefind-ui.js';
				script.onload = function () {
					if (typeof PagefindUI !== 'undefined') {
						new PagefindUI({
							element: '#exp-pagefind-container',
							showSubResults: true,
							showImages: false,
						});
					} else {
						showLocalSearch();
					}
					var input = document.querySelector('#exp-pagefind-container input');
					if (input) {
						syncSearchShortcuts(input);
						input.focus();
					}
				};
				script.onerror = showLocalSearch;
				document.head.appendChild(script);
			} else {
				var input = document.querySelector('#exp-pagefind-container input');
				if (input) {
					syncSearchShortcuts(input);
					input.focus();
				}
			}
		}

		function closeSearch() {
			if (overlay) overlay.setAttribute('data-open', 'false');
		}

		triggers.forEach(function (btn) {
			btn.addEventListener('click', openSearch);
		});
		document.querySelector('[data-exp-search-close]')?.addEventListener('click', closeSearch);

		if (overlay) {
			overlay.addEventListener('click', function (e) {
				if (e.target === overlay) closeSearch();
			});
		}

		document.addEventListener('keydown', function (e) {
			if (e.key === '/' && !e.ctrlKey && !e.metaKey && !e.altKey) {
				var tag = (document.activeElement || {}).tagName;
				if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
				e.preventDefault();
				openSearch();
			}
			if (e.key === 'Escape') {
				closeSearch();
				closeMobileNav();
			}
		});
	})();
</script>
