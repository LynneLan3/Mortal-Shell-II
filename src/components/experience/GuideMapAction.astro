---
import { game } from '../../config/game';
import { mapRouteById } from '../../data/map-routes';
import { getCanonicalGuideUrlForMapMarker, getGuideMapKey, getMapTargetsForGuideUrl, normalizeGuideUrl } from '../../lib/toolkit-map';

const targets = getMapTargetsForGuideUrl(Astro.url.pathname);
const mapPath = `${game.hubPath}map/`;
const guideKey = getGuideMapKey(Astro.url.pathname);
const href = targets.length === 1
	? `${mapPath}?marker=${encodeURIComponent(targets[0].mapMarkerId)}`
	: `${mapPath}?guide=${encodeURIComponent(guideKey)}`;
const title = targets.length === 1
	? 'View on Map'
	: `View ${targets.length} locations on Map`;
const detail = targets.length === 1 ? targets[0].name : `${guideKey.split('-').map((word) => word.charAt(0).toUpperCase() + word.slice(1)).join(' ')} Guide`;
const currentGuideUrl = normalizeGuideUrl(Astro.url.pathname);
const relatedRoutes = [...mapRouteById.values()].filter((route) => (
	(route.guide && normalizeGuideUrl(route.guide) === currentGuideUrl)
	|| route.waypoints.some((waypoint) => normalizeGuideUrl(getCanonicalGuideUrlForMapMarker(waypoint.markerId) ?? '') === currentGuideUrl)
));
---

{targets.length > 0 && (
	<div class="guide-map-action" aria-label="Player Toolkit map action">
		<span class="guide-map-action__kicker">Player Toolkit</span>
		<a class="guide-map-action__link" href={href}>
			<span class="guide-map-action__icon" aria-hidden="true">⌖</span>
			<span class="guide-map-action__copy">
				<strong>{title}</strong>
				<span>{detail}</span>
			</span>
			<span class="guide-map-action__arrow" aria-hidden="true">→</span>
		</a>
		{relatedRoutes.length > 0 && (
			<p class="guide-map-action__route-context">
				<span>Part of this route</span>
				{relatedRoutes.map((route) => <a href={`${mapPath}?route=${route.id}`}>{route.name} <span aria-hidden="true">→</span></a>)}
			</p>
		)}
	</div>
)}
