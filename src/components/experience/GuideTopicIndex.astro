---
/**
 * Topic-based Guides Index.
 *
 * This is intentionally separate from the objective-led Route Index: the
 * same guide can support a player goal elsewhere, but appears only once in
 * the topic library here.
 */
import { game } from '../../config/game';
import { categoryOf, getGuides, guideHref, sortGuides } from '../../lib/guides';
import type { GameGuideVisual, GameGuideVisualIcon } from '../../config/game';
import type { GuideEntry } from '../../lib/guides';
import { ui } from '../../lib/ui';
import { resolveEntryCardImage, sortCardsByImage } from '../../lib/assets';
import CardThumbnail from '../CardThumbnail.astro';
import AuthorityHubGrid from './AuthorityHubGrid.astro';
import HubSubnav from './HubSubnav.astro';
import { getPortalProminence, prominenceForHref } from '../../lib/hub-prominence';

const t = ui();
const guides = (await getGuides()).filter((entry) => Boolean(categoryOf(entry)));
const configuredGroups = game.portal?.guideTopicGroups ?? [];
const used = new Set<string>();

const fallbackIcons: Record<string, GameGuideVisualIcon> = {
	'weapons-resources': 'sword',
	'world-exploration': 'map',
	'completion-endgame': 'trophy',
	'start-general': 'book',
	'pc-fixes': 'monitor',
};

const iconPaths: Record<GameGuideVisualIcon, string> = {
	book: '<path d="M5 4.5h5.5a2 2 0 0 1 2 2v12a2 2 0 0 0-2-2H5z"/><path d="M19 4.5h-5.5a2 2 0 0 0-2 2v12a2 2 0 0 1 2-2H19z"/>',
	calendar: '<rect x="4" y="5.5" width="16" height="14" rx="2"/><path d="M8 3.5v4M16 3.5v4M4 10h16"/>',
	gem: '<path d="m7 4 5-1 5 1 3 5-8 11-8-11z"/><path d="m7 4 5 5 5-5M4 9h16"/>',
	map: '<path d="m4 5 5-2 6 2 5-2v16l-5 2-6-2-5 2z"/><path d="M9 3v16M15 5v16"/>',
	monitor: '<rect x="3.5" y="5" width="17" height="12" rx="2"/><path d="M9 20h6M12 17v3"/>',
	refresh: '<path d="M20 11a8 8 0 0 0-14.5-4L4 9"/><path d="M4 4v5h5M4 13a8 8 0 0 0 14.5 4L20 15"/><path d="M20 20v-5h-5"/>',
	shield: '<path d="M12 3 19 6v5c0 4.5-2.8 8-7 10-4.2-2-7-5.5-7-10V6z"/><path d="m9 12 2 2 4-4"/>',
	shell: '<path d="M4 18c0-7 3.5-12 8-12s8 5 8 12"/><path d="M4 18c2.5-2 5.2-3 8-3s5.5 1 8 3M7 10c.8 1 1.7 1.8 2.8 2.4M17 10c-.8 1-1.7 1.8-2.8 2.4"/>',
	sword: '<path d="M14.5 4.5 19.5 2 17 7l-8.5 8.5-2-2z"/><path d="m6.5 13.5 4 4M4 20l3.5-3.5"/>',
	trophy: '<path d="M7 4h10v5c0 3-2 5-5 6-3-1-5-3-5-6z"/><path d="M7 6H4v2c0 2 1.5 3.5 4 3.5M17 6h3v2c0 2-1.5 3.5-4 3.5M12 15v4M8 21h8"/>',
};

function visualForEntry(entry: GuideEntry): GameGuideVisual {
	const href = guideHref(entry);
	const configured = game.portal?.guideVisuals?.[href];
	const image = resolveEntryCardImage(entry, href);
	if (image) {
		return {
			...configured,
			image: typeof image.src === 'string' ? image.src : image.src.src,
			alt: image.alt,
		};
	}
	return configured ?? {};
}

const groups = configuredGroups
	.map((group) => {
		const entries = sortCardsByImage(group.guideOrder
			.map((href) => guides.find((entry) => guideHref(entry) === href))
			.filter((entry): entry is GuideEntry => Boolean(entry)), (entry) => resolveEntryCardImage(entry, guideHref(entry)));
		entries.forEach((entry) => used.add(entry.id));
		return { ...group, entries };
	})
	.filter((group) => group.entries.length > 0);

const unassigned = sortCardsByImage(guides.filter((entry) => !used.has(entry.id)).sort(sortGuides), (entry) => resolveEntryCardImage(entry, guideHref(entry)));
if (unassigned.length > 0) {
	groups.push({
		id: 'more-guides',
		title: 'More Guides',
		description: 'Additional pages that do not yet need a dedicated launch-window topic group.',
		guideOrder: unassigned.map((entry) => guideHref(entry)),
		entries: unassigned,
	});
}

const topicOrder = ['start-general', 'world-exploration', 'weapons-resources', 'completion-endgame', 'pc-fixes'];
groups.sort((a, b) => (topicOrder.indexOf(a.id) < 0 ? topicOrder.length : topicOrder.indexOf(a.id)) - (topicOrder.indexOf(b.id) < 0 ? topicOrder.length : topicOrder.indexOf(b.id)));

const portalSignals = getPortalProminence(game.portal);
const guideByHref = new Map(guides.map((entry) => [guideHref(entry), entry]));
const hotSpotlight = (game.portal?.hotGuides ?? [])
	.slice(0, 4)
	.map((item) => ({ ...item, entry: guideByHref.get(item.href), prominence: 'hot' as const }))
	.filter((item): item is typeof item & { entry: GuideEntry } => Boolean(item.entry));
const popularSpotlight = (game.portal?.featuredOrder ?? [])
	.map((value) => `/${value.replace(/^\/+|\/+$/g, '')}/`)
	.map((href) => ({ href, entry: guideByHref.get(href), prominence: prominenceForHref(href, portalSignals) }))
	.filter((item): item is typeof item & { entry: GuideEntry; prominence: 'popular' } => Boolean(item.entry) && item.prominence === 'popular')
	.slice(0, 2)
	.map((item) => ({ ...item, title: item.entry.data.title, description: item.entry.data.description }));
const spotlight = [
	...hotSpotlight,
	...popularSpotlight,
].slice(0, 6);
const subnavItems = [
	{ id: 'overview', label: 'Overview' },
	...groups.map((group) => ({ id: group.id, label: group.title })),
];
---

<section class="exp-guide-topic-index">
	<header class="exp-guide-topic-index__hero hub-scroll-target" id="overview">
		<div class="exp-content">
			<p class="exp-eyebrow">{t.fieldGuide}</p>
			<h1 class="exp-h1">{t.allGuides}</h1>
			<p class="exp-lede">Browse the guide library by topic. Use By Goal when you want a recommended player route instead.</p>
		</div>
	</header>

	<HubSubnav items={subnavItems} ariaLabel="Guide sections" />

	{spotlight.length > 0 && <section class="exp-content exp-guide-spotlight" aria-labelledby="exp-guide-spotlight-heading">
		<header class="exp-guide-spotlight__head">
			<div>
				<p class="exp-eyebrow">Current signal</p>
				<h2 class="exp-h2" id="exp-guide-spotlight-heading">Hot &amp; popular guides</h2>
			</div>
			<p class="exp-lede">HOT follows the existing priority guide list; POPULAR follows the existing featured order.</p>
		</header>
		<div class="exp-guide-spotlight__grid">
			{spotlight.map((item) => {
				const entry = item.entry;
				const visual = visualForEntry(entry);
				return (
					<a class="exp-guide-spotlight__card" href={guideHref(entry)}>
						{visual.image && <CardThumbnail className="exp-guide-spotlight__visual" image={visual.image} alt={visual.alt ?? ''} />}
						<span class="exp-guide-spotlight__body">
							<span class:list={['hub-prominence', `hub-prominence--${item.prominence}`]}>{item.prominence === 'hot' ? 'HOT' : 'POPULAR'}</span>
							<strong>{entry.data.title}</strong>
							<span>{entry.data.description}</span>
						</span>
					</a>
				);
			})}
		</div>
	</section>}

	{game.portal?.authorityHubs && game.portal.authorityHubs.length > 0 && (
		<section class="exp-content exp-guide-authority" aria-labelledby="exp-guide-authority-heading">
			<p class="exp-eyebrow">Guide + Wiki</p>
			<h2 class="exp-h2" id="exp-guide-authority-heading">{game.portal?.authoritySectionTitle ?? 'Core Hubs'}</h2>
			{game.portal?.authoritySectionDescription && <p class="exp-lede">{game.portal.authoritySectionDescription}</p>}
			<AuthorityHubGrid hubs={game.portal.authorityHubs} />
		</section>
	)}

	<div class="exp-content exp-guide-topic-index__groups">
		{groups.map((group, index) => (
			<section class="exp-guide-topic-group hub-scroll-target" id={group.id} aria-labelledby={`${group.id}-heading`}>
				<header class="exp-guide-topic-group__head">
					<p class="exp-eyebrow">Topic {String(index + 1).padStart(2, '0')}</p>
					<h2 class="exp-h2" id={`${group.id}-heading`}>{group.title}</h2>
					<p class="exp-lede">{group.description}</p>
				</header>
				<div class:list={['exp-guide-topic-grid', group.entries.some((entry) => Boolean(visualForEntry(entry).image)) && 'exp-guide-topic-grid--visual']}>
					{group.entries.map((entry) => {
						const visual = visualForEntry(entry);
						return (
							<a class:list={['exp-guide-topic-card', visual.image && 'exp-guide-topic-card--image']} href={guideHref(entry)}>
								{visual.image && <CardThumbnail className="exp-guide-topic-card__visual" image={visual.image} alt={visual.alt ?? ''} />}
								<span class="exp-guide-topic-card__body">
									<span class="exp-guide-topic-card__meta">{categoryOf(entry)?.label ?? t.guidesNav}</span>
									<span class="exp-guide-topic-card__title">{entry.data.title}</span>
									{entry.data.description && <span class="exp-guide-topic-card__desc">{entry.data.description}</span>}
									<span class="exp-guide-topic-card__cta">{t.readGuide}</span>
								</span>
							</a>
						);
					})}
				</div>
			</section>
		))}
	</div>
</section>
