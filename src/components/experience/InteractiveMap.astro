---
import { mapBasemap, mapMarkerById, type MapMarker } from '../../data/map-markers';
import { TOOLKIT_STORAGE_KEY, toolkitItems, toolkitItemByMapMarkerId } from '../../data/toolkit-items';
import { mapRoutes, mapRouteHref } from '../../data/map-routes';
import { getMapGuideGroups } from '../../lib/toolkit-map';
import { getCanonicalMapProgress, mergeToolkitProgressState, readToolkitProgressState } from '../../lib/toolkit-progress';
import { mapRegions, regionIdForMarker } from '../../data/map-regions';
import AchievementWorkspace from './AchievementWorkspace.astro';

interface Props { markers: readonly MapMarker[]; regionId?: string; }

const { markers, regionId = '' } = Astro.props;
const markerIcons: Record<string, string> = {
	Shells: '◇', Weapons: '⚔', Sidearms: '➹', Bosses: '☠', 'Map Fragments': '▧', NPCs: '♙', Dungeons: '⌂',
	Beacons: '✦', Keys: '⌑', Tarforge: '♢', 'Night Mode': '☾', 'Corrupted Gates': '⌁', Quests: '◇', Other: '•',
};
const workspaceCategories = [
	{ id: 'Shells', label: 'Shells', icon: markerIcons.Shells },
	{ id: 'Weapons', label: 'Weapons', icon: markerIcons.Weapons },
	{ id: 'Sidearms', label: 'Sidearms', icon: markerIcons.Sidearms },
	{ id: 'Map Fragments', label: 'Map Fragments', icon: markerIcons['Map Fragments'] },
	{ id: 'Bosses', label: 'Bosses', icon: markerIcons.Bosses },
	{ id: 'Beacons', label: 'Beacons / Stations', icon: markerIcons.Beacons },
	{ id: 'NPCs', label: 'NPCs', icon: markerIcons.NPCs },
	{ id: 'Dungeons', label: 'Dungeons', icon: markerIcons.Dungeons },
];
const routeIdsByMarkerId = new Map<string, string[]>();
mapRoutes.forEach((route) => route.waypoints.forEach((waypoint) => routeIdsByMarkerId.set(waypoint.markerId, [...(routeIdsByMarkerId.get(waypoint.markerId) ?? []), route.id])));
const mapGuideGroups = getMapGuideGroups();
const guideKeyByMarkerId = new Map(mapGuideGroups.flatMap((group) => group.targets.map((target) => [target.mapMarkerId, group.key] as const)));
const regionStats = mapRegions.map((region) => {
	const regionMarkers = markers.filter((marker) => regionIdForMarker(marker) === region.id);
	return { ...region, markerCount: regionMarkers.length, shells: regionMarkers.filter((marker) => marker.category === 'Shells').length, fragments: regionMarkers.filter((marker) => marker.category === 'Map Fragments').length };
});
const mapPayload = {
	markers: markers.map((marker) => ({ ...marker, toolkitId: toolkitItemByMapMarkerId.get(marker.id)?.id ?? '', guideKey: guideKeyByMarkerId.get(marker.id) ?? '' })),
	regions: regionStats,
	routes: mapRoutes,
	basemap: mapBasemap,
};
---

<section class:list={['map-page', regionId && 'map-page--region']} data-map-app data-map-region-page={regionId || undefined} data-storage-key={TOOLKIT_STORAGE_KEY}>
	<script type="application/json" data-map-config set:html={JSON.stringify(mapPayload)}></script>
	<header class="map-page__toolbar">
		<div class="map-page__toolbar-context">{regionId && <a class="map-back-link" href="/mortal-shell-ii/map/">← World map</a>}<span class="map-page__toolbar-title">{regionId ? mapRegions.find((region) => region.id === regionId)?.name ?? regionId : 'World Map'}</span></div>
		<div class="map-page__toolbar-actions"><button class="map-toolbar-button" type="button" data-map-progress-toggle aria-expanded="false">Progress <span data-map-progress-summary>0%</span></button><a class="map-page__guide-link" href="/mortal-shell-ii/routes/">Routes ↗</a></div>
	</header>

	<div class="map-workspace">
		<section class="map-panel map-panel--canvas" aria-label={regionId ? 'Interactive region map' : 'Interactive world map'}>
			<div class="map-viewport" data-map-viewport><div class="map-leaflet" data-map-leaflet aria-label="Mortal Shell II interactive map"></div><div class="map-attribution"><span>Basemap: <a href={mapBasemap.sourceUrl} target="_blank" rel="noreferrer">{mapBasemap.sourceName}</a></span><span>Temporary third-party asset · replaceLater</span></div></div>
			<div class="map-controls" aria-label="Map controls"><button type="button" data-map-zoom-out aria-label="Zoom out">−</button><span data-map-zoom-label>World</span><button type="button" data-map-zoom-in aria-label="Zoom in">+</button><button type="button" data-map-fit aria-label="Fit the full map">Fit world</button><span class="map-controls__hint">Markers use normalized image coordinates · {mapBasemap.width}×{mapBasemap.height}</span></div>
		</section>

		<aside class="map-control-center" data-map-tools-panel aria-label="Map controls">
			<section class="map-control-section map-control-section--search"><div class="map-control-section__heading"><div><p class="map-panel__eyebrow">Search / Layers</p><h2>Find an objective</h2></div><span class="map-toolbar__count" data-toolkit-count>{toolkitItems.length} tracked</span></div><label class="map-search" for="toolkit-search"><span class="map-search__icon" aria-hidden="true">⌕</span><input id="toolkit-search" type="search" placeholder="Search markers or regions..." autocomplete="off" data-toolkit-search /></label><div class="map-search-results" data-map-search-results hidden></div><div class="map-layer-controls" aria-label="Map layers">{!regionId && <label><input type="checkbox" data-map-layer-regions checked /><span>Regions</span></label>}<label><input type="checkbox" data-map-layer-markers checked /><span>Markers</span></label><button class="map-clear-button" type="button" data-toolkit-reset>Reset</button></div></section>

			<section class="map-control-section" aria-labelledby="map-filter-heading"><div class="map-control-section__title-row"><div><p class="map-panel__eyebrow">Marker layers</p><h3 id="map-filter-heading">Keep the canvas readable</h3></div><span class="map-toolbar__count" data-map-visible-count>{markers.length} visible</span></div><div class="map-category-controls"><button class="map-category-control is-active" type="button" data-map-category="all"><span class="map-category-control__icon" aria-hidden="true">✦</span><span class="map-category-control__copy"><strong>All mapped targets</strong><small>{markers.length} markers</small></span><span class="map-category-control__count" data-category-count="all">{markers.length}</span></button>{workspaceCategories.map((category) => <button class="map-category-control" type="button" data-map-category={category.id}><span class="map-category-control__icon" aria-hidden="true">{category.icon}</span><span class="map-category-control__copy"><strong>{category.label}</strong><small>Mapped layer</small></span><span class="map-category-control__count" data-category-count={category.id}>{markers.filter((marker) => marker.category === category.id).length}</span></button>)}</div><label class="map-hide-completed"><input type="checkbox" data-hide-completed /><span>Hide completed</span></label></section>

			<section class="map-control-section map-control-section--detail" aria-live="polite" data-map-details aria-labelledby="marker-detail-heading"><div class="map-details__empty" data-map-empty><p class="map-panel__eyebrow">Marker detail</p><h3 id="marker-detail-heading">Select a target</h3><p>Click a marker to see its location, route relationship, completion control, and guide.</p></div>{markers.map((marker) => { const item = toolkitItemByMapMarkerId.get(marker.id); const relatedRoutes = (routeIdsByMarkerId.get(marker.id) ?? []).map((routeId) => mapRoutes.find((route) => route.id === routeId)).filter(Boolean); const nearbyMarkers = (marker.nearby ?? []).map((markerId) => mapMarkerById.get(markerId)).filter(Boolean); return <article class="map-detail" data-map-detail={marker.id} hidden><div class="map-detail__heading"><span class:list={['map-detail__icon', `map-detail__icon--${marker.category.toLowerCase().replaceAll(' ', '-')}`]} aria-hidden="true">{markerIcons[marker.category] ?? '•'}</span><div><p class="map-panel__eyebrow">{marker.category}</p><h3>{marker.name}</h3><p class="map-detail__region">{marker.region}</p></div></div><p class="map-detail__description">{marker.description}</p>{marker.requirements && <p class="map-detail__note"><strong>Requirements:</strong> {marker.requirements}</p>}{marker.usefulNote && <p class="map-detail__note"><strong>Why it matters:</strong> {marker.usefulNote}</p>}{item && <label class="toolkit-complete-control"><input type="checkbox" data-toolkit-checkbox={item.id} /><span data-toolkit-checkbox-label>Mark completed</span></label>}<div class="map-detail__related">{relatedRoutes.length > 0 && <><p class="map-panel__eyebrow">Part of</p>{relatedRoutes.map((route) => route && <a class="map-detail__route-link" href={mapRouteHref(route.id)} target="_blank" rel="noopener noreferrer">{route.name} ↗</a>)}</>}{nearbyMarkers.length > 0 && <><p class="map-panel__eyebrow">Nearby mapped target</p>{nearbyMarkers.map((nearby) => nearby && <button class="map-related-button" type="button" data-map-related-marker={nearby.id}>{markerIcons[nearby.category] ?? '•'} {nearby.name}</button>)}</>}</div><div class="map-detail__actions">{marker.guideUrl && <a class="map-detail__link" href={marker.guideUrl} target="_blank" rel="noopener noreferrer">Open Full Guide <span aria-hidden="true">↗</span></a>}<a class="map-detail__source" href={marker.source} target="_blank" rel="noreferrer">Research source ↗</a></div></article>; })}</section>
		</aside>
	</div>

		<dialog class="map-progress-modal" data-map-progress-dialog aria-labelledby="map-progress-title"><div class="map-progress-modal__inner"><header class="map-progress-modal__head"><div class="map-progress-modal__title"><p class="map-panel__eyebrow">Completion</p><h2 id="map-progress-title">Progress</h2></div><div class="map-progress-modal__actions"><button type="button" class="map-progress-modal__action map-progress-modal__action--reset" data-completion-reset>Reset Draft</button><button type="button" class="map-progress-modal__action map-progress-modal__action--cancel" data-completion-cancel>Cancel</button><button type="button" class="map-progress-modal__action map-progress-modal__action--confirm" data-completion-confirm>Confirm</button><button type="button" class="map-progress-modal__close" data-map-progress-close aria-label="Close progress">×</button></div></header><div class="map-progress-modal__content"><AchievementWorkspace draft /></div></div></dialog>
	<p class="map-note">Coordinates use one normalized data contract: <code>xNorm</code>/<code>yNorm</code> from the basemap top-left. The current {mapBasemap.width}×{mapBasemap.height} basemap remains a temporary third-party LootMap asset; Basemap debt is NOT CLEARED.</p>
</section>

<script>
	import L from 'leaflet';
	import 'leaflet/dist/leaflet.css';
	import { normalizedToLeaflet, regionBoundsToLeaflet } from '../../lib/map-coordinates';
	import { getCanonicalMapProgress, mergeToolkitProgressState, readToolkitProgressState } from '../../lib/toolkit-progress';

	const app = document.querySelector('[data-map-app]');
	if (app) {
		const configNode = app.querySelector('[data-map-config]');
		const config = JSON.parse(configNode?.textContent || '{}');
		const mapElement = app.querySelector('[data-map-leaflet]');
		const markers = config.markers || [];
		const regions = config.regions || [];
		const routes = config.routes || [];
		const mapWidth = config.basemap.width;
		const mapHeight = config.basemap.height;
		const storageKey = app.getAttribute('data-storage-key') || 'ms2-toolkit-progress-v1';
		const pageRegionId = app.getAttribute('data-map-region-page') || '';
		const markerById = new Map(markers.map((marker) => [marker.id, marker]));
		const markerLayers = new Map();
		const regionLayers = new Map();
		const routeLayer = L.layerGroup();
		const map = L.map(mapElement, { crs: L.CRS.Simple, zoomControl: false, attributionControl: false, minZoom: -2, maxZoom: 4, zoomSnap: 0.25, zoomDelta: 0.5, maxBoundsViscosity: 0.8, doubleClickZoom: true, scrollWheelZoom: true, touchZoom: true });
		const imageBounds = [[0, 0], [mapHeight, mapWidth]];
		L.imageOverlay(config.basemap.image, imageBounds, { opacity: 0.96, interactive: false }).addTo(map);
		map.setMaxBounds([[-mapHeight * 0.08, -mapWidth * 0.08], [mapHeight * 1.08, mapWidth * 1.08]]);
		const zoomLabel = app.querySelector('[data-map-zoom-label]');
		const setZoomLabel = () => { if (zoomLabel) zoomLabel.textContent = `${Math.round(2 ** map.getZoom() * 100)}%`; };
		const iconFor = (category, routeNumber = '') => L.divIcon({ className: `leaflet-marker-icon map-leaflet-marker map-leaflet-marker--${String(category).toLowerCase().replaceAll(' ', '-')}`, html: `<span class="map-leaflet-marker__glyph" aria-hidden="true">${({ Shells: '◇', Weapons: '⚔', Sidearms: '➹', Bosses: '☠', 'Map Fragments': '▧', Beacons: '✦', NPCs: '♙', Dungeons: '⌂' }[category] || '•')}</span>${routeNumber ? `<span class="map-leaflet-marker__number">${routeNumber}</span>` : ''}`, iconSize: [42, 42], iconAnchor: [21, 21], tooltipAnchor: [0, -22] });
		const markerTooltip = (marker) => `${marker.name}<span>${marker.category} · ${marker.region}</span>`;
		markers.forEach((marker) => {
			const layer = L.marker(normalizedToLeaflet(marker, mapWidth, mapHeight), { icon: iconFor(marker.category), title: marker.name, riseOnHover: true }).addTo(map);
			layer.bindTooltip(markerTooltip(marker), { direction: 'top', sticky: true, className: 'map-leaflet-tooltip' });
			layer.on('click', () => showMarker(marker.id, true));
			markerLayers.set(marker.id, layer);
		});
		regions.forEach((region) => {
			const layer = L.rectangle(regionBoundsToLeaflet(region, mapWidth, mapHeight), { color: '#f2b36b', weight: 1, opacity: 0.52, fillColor: '#f2b36b', fillOpacity: 0.06, interactive: true }).addTo(map);
			layer.bindTooltip(`${region.name}<span>${region.markerCount} mapped · ${region.shells} Shells · ${region.fragments} fragments</span>`, { sticky: true, className: 'map-leaflet-tooltip' });
			layer.on('click', () => focusRegion(region.id, true));
			regionLayers.set(region.id, layer);
		});
		const categoryButtons = Array.from(app.querySelectorAll('[data-map-category]'));
		const checkboxes = Array.from(app.querySelectorAll('[data-toolkit-checkbox]'));
		const checklistItems = Array.from(app.querySelectorAll('[data-toolkit-item]'));
		const routeCards = Array.from(app.querySelectorAll('[data-map-route-card]'));
		const validRouteIds = new Set(routeCards.map((card) => card.getAttribute('data-map-route-card')).filter(Boolean));
		const search = app.querySelector('[data-toolkit-search]');
		const searchResults = app.querySelector('[data-map-search-results]');
		const hideCompleted = app.querySelector('[data-hide-completed]');
		const routeStrip = app.querySelector('[data-map-route-strip]');
		const empty = app.querySelector('[data-map-empty]');
		let completedIds = new Set();
		let activeCategory = 'all';
		let activeRouteId = '';
		let activeMarkerId = '';
		let activeRegionId = pageRegionId;
		let activeGuideKey = '';

		function readState() { const state = readToolkitProgressState(window.localStorage, storageKey); completedIds = new Set(state.completedIds); if (validRouteIds.has(state.activeRouteId)) activeRouteId = state.activeRouteId; if (categoryButtons.some((button) => button.getAttribute('data-map-category') === state.activeCategory)) activeCategory = state.activeCategory; if (hideCompleted instanceof HTMLInputElement) hideCompleted.checked = state.hideCompleted; if (search instanceof HTMLInputElement) search.value = state.search; }
		function saveState(changes = {}) { const state = mergeToolkitProgressState({ activeRouteId, activeCategory, hideCompleted: hideCompleted instanceof HTMLInputElement && hideCompleted.checked, search: search instanceof HTMLInputElement ? search.value : '', ...changes }, window.localStorage, storageKey); completedIds = new Set(state.completedIds); }
		function setUrl(values) { const url = new URL(window.location.href); Object.entries(values).forEach(([key, value]) => value ? url.searchParams.set(key, String(value)) : url.searchParams.delete(key)); window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`); }
		function routeCard(id) { return routeCards.find((card) => card.getAttribute('data-map-route-card') === id); }
		function routeMarkerIds(id) { return routeCard(id)?.getAttribute('data-route-waypoints')?.split(',').filter(Boolean) || []; }
		function routeSteps(id) { return Array.from(routeCard(id)?.querySelectorAll('[data-route-waypoint]') || []); }
		function routeProgress(id) { const steps = routeSteps(id); const currentIndex = steps.findIndex((step) => { const itemId = step.getAttribute('data-route-item-id'); return !itemId || !completedIds.has(itemId); }); return { steps, currentIndex, current: currentIndex >= 0 ? steps[currentIndex] : undefined, next: currentIndex >= 0 ? steps[currentIndex + 1] : undefined }; }
		function currentRouteMarker(id) { return routeProgress(id).current?.getAttribute('data-route-waypoint') || ''; }
		function drawRoute() { routeLayer.clearLayers(); if (!activeRouteId) return; const route = routes.find((candidate) => candidate.id === activeRouteId); const points = (route?.waypoints || []).map((step) => markerById.get(step.markerId)).filter(Boolean).map((marker) => normalizedToLeaflet(marker, mapWidth, mapHeight)); if (points.length > 1) L.polyline(points, { color: '#f2b36b', weight: 3, opacity: 0.82, dashArray: '7 8', interactive: false }).addTo(routeLayer); routeLayer.addTo(map); }
		function applyVisibility() { const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : ''; const routeMarkerList = routeMarkerIds(activeRouteId); const routeIds = new Set(routeMarkerList); let visible = 0; markers.forEach((marker) => { const layer = markerLayers.get(marker.id); if (!layer) return; const completed = marker.toolkitId && completedIds.has(marker.toolkitId); const matches = (!query || `${marker.name} ${marker.category} ${marker.region}`.toLowerCase().includes(query)) && (!activeGuideKey || marker.guideKey === activeGuideKey) && (activeCategory === 'all' || marker.category === activeCategory) && (!hideCompleted?.checked || !completed); const routeMatch = !activeRouteId || routeIds.has(marker.id); layer.setOpacity(matches ? (routeMatch ? 1 : 0.18) : 0); layer.setZIndexOffset(marker.id === currentRouteMarker(activeRouteId) ? 1000 : routeMatch ? 300 : 0); layer.setIcon(iconFor(marker.category, activeRouteId && routeIds.has(marker.id) ? String(routeMarkerList.indexOf(marker.id) + 1) : '')); layer.getElement()?.classList.toggle('is-selected', marker.id === activeMarkerId); layer.getElement()?.classList.toggle('is-completed', Boolean(completed)); if (matches) visible += 1; }); categoryButtons.forEach((button) => button.classList.toggle('is-active', button.getAttribute('data-map-category') === activeCategory)); const visibleNode = app.querySelector('[data-map-visible-count]'); if (visibleNode) visibleNode.textContent = `${visible} visible`; const markerLayerToggle = app.querySelector('[data-map-layer-markers]'); if (markerLayerToggle instanceof HTMLInputElement && !markerLayerToggle.checked) markerLayers.forEach((layer) => layer.setOpacity(0)); const regionLayerToggle = app.querySelector('[data-map-layer-regions]'); regionLayers.forEach((layer) => layer.setStyle({ opacity: regionLayerToggle instanceof HTMLInputElement && regionLayerToggle.checked ? 0.52 : 0, fillOpacity: regionLayerToggle instanceof HTMLInputElement && regionLayerToggle.checked ? 0.06 : 0 })); const routeToggle = app.querySelector('[data-map-layer-route]'); if (routeToggle instanceof HTMLInputElement && !routeToggle.checked) routeLayer.removeFrom(map); else if (activeRouteId) routeLayer.addTo(map); checklistItems.forEach((item) => item.classList.toggle('is-completed', completedIds.has(item.getAttribute('data-toolkit-item')))); }
		function updateProgress() { const canonical = getCanonicalMapProgress(completedIds); const node = app.querySelector('[data-map-progress-summary]'); if (node) node.textContent = `${canonical.percent}%`; checkboxes.forEach((checkbox) => { const id = checkbox.getAttribute('data-toolkit-checkbox'); if (checkbox instanceof HTMLInputElement) checkbox.checked = Boolean(id && completedIds.has(id)); const label = checkbox.parentElement?.querySelector('[data-toolkit-checkbox-label]'); if (label) label.textContent = id && completedIds.has(id) ? 'Completed' : 'Mark completed'; }); routeCards.forEach((card) => { const progress = routeProgress(card.getAttribute('data-map-route-card') || ''); const completed = progress.steps.filter((step) => { const id = step.getAttribute('data-route-item-id'); return id && completedIds.has(id); }).length; const count = card.querySelector('[data-route-completed]'); const percent = card.querySelector('[data-route-percent]'); const bar = card.querySelector('[data-route-bar]'); if (count) count.textContent = String(completed); if (percent) percent.textContent = `${progress.steps.length ? Math.round(completed / progress.steps.length * 100) : 0}%`; if (bar) bar.style.width = `${progress.steps.length ? completed / progress.steps.length * 100 : 0}%`; progress.steps.forEach((step, index) => { const state = step.querySelector('[data-route-waypoint-state]'); if (state) state.textContent = index < progress.currentIndex || progress.currentIndex < 0 ? 'Complete' : index === progress.currentIndex ? 'Current' : 'Next'; }); }); updateRouteStrip(); }
		function updateRouteStrip() { const route = routes.find((candidate) => candidate.id === activeRouteId); if (!routeStrip || !route) { if (routeStrip) routeStrip.hidden = true; return; } routeStrip.hidden = false; const progress = routeProgress(activeRouteId); const put = (selector, value) => { const node = routeStrip.querySelector(selector); if (node) node.textContent = value; }; put('[data-map-active-route-name]', route.name); put('[data-map-active-route-current]', markerById.get(currentRouteMarker(activeRouteId))?.name || 'All waypoints complete'); put('[data-map-active-route-next]', markerById.get(progress.next?.getAttribute('data-route-waypoint') || '')?.name || 'Route complete'); const planner = routeStrip.querySelector('[data-map-active-route-planner]'); if (planner && route.plannerHref) planner.setAttribute('href', route.plannerHref); }
		function coverWorld(animate = false) { map.invalidateSize({ pan: false }); const size = map.getSize(); const coverScale = Math.max(size.x / mapWidth, size.y / mapHeight); const zoom = Math.max(map.getMinZoom(), Math.min(map.getMaxZoom(), Math.log2(coverScale))); map.setView([mapHeight / 2, mapWidth / 2], zoom, { animate }); }
		function fitWorld(animate = true) { map.fitBounds(imageBounds, { padding: [20, 20], animate }); }
		function reconcileCompletionState() { readState(); updateProgress(); drawRoute(); applyVisibility(); }
		function showMarker(id, focus = false) { const marker = markerById.get(id); const layer = markerLayers.get(id); if (!marker || !layer) return; activeMarkerId = id; if (focus) { if (search instanceof HTMLInputElement) search.value = ''; activeGuideKey = ''; activeCategory = 'all'; if (hideCompleted instanceof HTMLInputElement) hideCompleted.checked = false; map.flyTo(normalizedToLeaflet(marker, mapWidth, mapHeight), Math.max(map.getZoom(), 0.8), { duration: 0.55 }); layer.openTooltip(); } app.querySelectorAll('[data-map-detail]').forEach((detail) => { detail.hidden = detail.getAttribute('data-map-detail') !== id; }); if (empty) empty.hidden = true; setUrl({ marker: id, route: activeRouteId, step: activeRouteId ? id : '' }); saveState(); applyVisibility(); }
		function focusRegion(id, updateUrl = false) { const region = regions.find((candidate) => candidate.id === id); if (!region) return; activeRegionId = id; map.flyToBounds(regionBoundsToLeaflet(region, mapWidth, mapHeight), { padding: [36, 36], duration: 0.55, maxZoom: 1.8 }); if (updateUrl && !pageRegionId) setUrl({ region: id }); }
		function startRoute(id, focus = true) { if (!validRouteIds.has(id)) return; activeRouteId = id; drawRoute(); updateProgress(); const current = currentRouteMarker(id); setUrl({ route: id, step: current, marker: focus ? current : '' }); if (focus && current) showMarker(current, true); applyVisibility(); }
		function exitRoute() { activeRouteId = ''; routeLayer.clearLayers(); routeLayer.removeFrom(map); setUrl({ route: '', step: '' }); updateProgress(); applyVisibility(); }
		function renderSearchResults() { if (!(search instanceof HTMLInputElement) || !searchResults) return; const query = search.value.trim().toLowerCase(); if (!query) { searchResults.hidden = true; searchResults.innerHTML = ''; return; } const markerResults = markers.filter((marker) => `${marker.name} ${marker.category} ${marker.region}`.toLowerCase().includes(query)).slice(0, 8); const regionResults = regions.filter((region) => region.name.toLowerCase().includes(query)); searchResults.innerHTML = [...regionResults.map((region) => `<button type="button" data-search-region="${region.id}"><strong>${region.name}</strong><span>Region focus</span></button>`), ...markerResults.map((marker) => `<button type="button" data-search-marker="${marker.id}"><strong>${marker.name}</strong><span>${marker.category} · ${marker.region}</span></button>`)].join(''); searchResults.hidden = !searchResults.childElementCount; searchResults.querySelectorAll('[data-search-marker]').forEach((button) => button.addEventListener('click', () => { showMarker(button.getAttribute('data-search-marker') || '', true); searchResults.hidden = true; })); searchResults.querySelectorAll('[data-search-region]').forEach((button) => button.addEventListener('click', () => { focusRegion(button.getAttribute('data-search-region') || '', true); searchResults.hidden = true; })); }
		readState(); map.on('zoomend', setZoomLabel); setZoomLabel(); coverWorld(false); if (pageRegionId) focusRegion(pageRegionId); else { const initialRegion = new URL(window.location.href).searchParams.get('region'); if (initialRegion) focusRegion(initialRegion); }
