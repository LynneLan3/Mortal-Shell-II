---
/**
 * Route Fast Answers — quick-answer list for a Route Hub.
 *
 * Rendered only when the route provides fast answers (max 3 in the contract).
 * Links point at formal runtime hrefs.
 */
import { ui } from '../../../lib/ui';
import type { GameRouteFastAnswer } from '../../../config/game';

interface Props {
	answers: readonly GameRouteFastAnswer[];
}

const { answers } = Astro.props;
const t = ui();
---

<section class="exp-section">
	<div class="exp-reading">
		<p class="exp-eyebrow">{t.fastAnswers}</p>
		<h2 class="exp-h2">{t.commonQuestionsLede}</h2>
		<div style="margin-top: 1.5rem;">
			<div class="exp-fast-answers">
				{answers.map((fa) => (
					<div class="exp-fast-answer">
						<span class="exp-fast-answer__q">{fa.question}</span>
						<a class="exp-fast-answer__link exp-cta-link" href={fa.href}>
							{t.read} →
						</a>
						<span class="exp-fast-answer__a">{fa.answer}</span>
					</div>
				))}
			</div>
		</div>
	</div>
</section>
