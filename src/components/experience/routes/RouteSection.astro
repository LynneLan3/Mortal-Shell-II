---
/**
 * One route section inside the Guides Index.
 *
 * `visual` is optional. When absent, a content-only variant renders with no
 * image slot, no placeholder, and no broken-image state. The guide list keeps
 * the route's configured page order.
 */
import { Image } from 'astro:assets';
import { ui } from '../../../lib/ui';
import { resolveGameAsset } from '../../../lib/assets';
import type { GameRoute } from '../../../config/game';

interface Props {
	route: GameRoute;
	number: string;
}

const { route, number } = Astro.props;
const t = ui();
const visualAsset = resolveGameAsset(route.visual, 'route.visual');
---

<div
	class:list={['exp-route-section', !visualAsset && 'exp-route-section--content-only']}
>
	<div class="exp-route-section__inner">
		{visualAsset && (
			<a class="exp-route-section__visual" href={route.href} aria-label={t.openRoute(route.title)}>
				<Image
					src={visualAsset}
					alt={`${route.title} route visual`}
					width={960}
					height={540}
					widths={[480, 800, 1200, 1600]}
					sizes="(min-width: 50rem) 50vw, 100vw"
					loading="lazy"
					decoding="async"
				/>
				<span class="exp-number exp-number--watermark">{number}</span>
				<span class="exp-route-section__visual-cta">{t.openRoute(route.title)}</span>
			</a>
		)}
		<div class="exp-route-section__content">
			<div class="exp-route-section__head">
				<span class="exp-number exp-number--md">{number}</span>
				<a class="exp-route-section__label" href={route.href}>{route.title}</a>
			</div>
			<p class="exp-route-section__desc">{route.description}</p>
			<div class="exp-route-section__guides">
				{route.pages.map((page) => (
					<a class="exp-route-section__guide-link" href={page.href}>
						{page.title}
						<span class="exp-route-section__guide-arrow" aria-hidden="true">→</span>
					</a>
				))}
			</div>
			<a class="exp-cta-link" href={route.href}>
				{t.openRoute(route.title)}
			</a>
		</div>
	</div>
</div>
