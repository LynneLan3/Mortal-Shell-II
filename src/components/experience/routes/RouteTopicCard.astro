---
/**
 * RouteTopicCard — primary player-task card for Homepage and Routes Index.
 *
 * Route is a player path, not a Category. This card summarizes the Route and
 * previews its ordered guide membership without expanding into a taxonomy tree.
 */
import { ui } from '../../../lib/ui';
import { resolveGameAsset } from '../../../lib/assets';
import CardThumbnail from '../../CardThumbnail.astro';
import type { GameRoute } from '../../../config/game';
import { mapRoutes, mapRouteHref } from '../../../data/map-routes';

interface Props {
	route: GameRoute;
	number: string;
	variant?: 'topic' | 'primary';
}

const { route, number, variant = 'topic' } = Astro.props;
const t = ui();
const visualAsset = resolveGameAsset(route.visual, 'route.visual');
const previewPages = route.pages.slice(0, 3);
const relatedMapRoutes = route.id === 'world-progression'
	? mapRoutes.filter((candidate) => ['fainweald-map-fragments', 'mammon-cleanup'].includes(candidate.id))
	: route.id === 'weapons-resources'
		? mapRoutes.filter((candidate) => candidate.id === 'fainweald-shells')
		: [];
---

<article
	class:list={[
		'exp-route-topic-card',
		`exp-route-topic-card--${variant}`,
		!visualAsset && 'exp-route-topic-card--text',
	]}
>
	<a class="exp-route-topic-card__link" href={route.href}>
		{visualAsset ? (
			<CardThumbnail
				className="exp-route-topic-card__visual"
				image={visualAsset}
				alt={`${route.title} route visual`}
				sizes="(min-width: 50rem) 50vw, 100vw"
			/>
		) : (
			<div class="exp-route-topic-card__visual exp-route-topic-card__visual--fallback" aria-hidden="true">◈</div>
		)}
		<div class="exp-route-topic-card__body">
			<div class="exp-route-topic-card__meta">
				<span class="exp-route-topic-card__number">{number}</span>
			</div>
			<h3 class="exp-route-topic-card__title">{route.title}</h3>
			<p class="exp-route-topic-card__desc">{route.description}</p>
			{previewPages.length > 0 && (
				<ul class="exp-route-topic-card__preview" aria-label={t.followTheRoute}>
					{previewPages.map((page) => (
						<li>{page.title}</li>
					))}
				</ul>
			)}
			<div class="exp-route-topic-card__footer">
				<span>{t.guideCount(route.pages.length)}</span>
				<span class="exp-cta-link">{t.openRoute(route.title)}</span>
			</div>
		</div>
	</a>
	{relatedMapRoutes.length > 0 && (
		<div class="exp-route-topic-card__related">
			<span>Related Routes</span>
			{relatedMapRoutes.map((mapRoute) => <a href={mapRouteHref(mapRoute.id)} target="_blank" rel="noopener noreferrer">{mapRoute.name} ↗</a>)}
		</div>
	)}
</article>
