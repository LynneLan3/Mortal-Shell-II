---
import Default from '@astrojs/starlight/components/Head.astro';
import VercelAnalytics from '@vercel/analytics/astro';
import AdcashAutotag from '../AdcashAutotag.astro';
import AdSenseVerification from '../AdSenseVerification.astro';
import Analytics from '../Analytics.astro';
import GuideStructuredData from '../GuideStructuredData.astro';
import { isExperienceGuide } from '../../lib/experience-guide';

const isExperience = isExperienceGuide(
	Astro.locals.starlightRoute.entry,
	Astro.url.pathname,
) && Astro.locals.starlightRoute.entry.id !== 'privacy';
const isDocument = Astro.locals.starlightRoute.entry.data.template !== 'splash'
	&& Astro.locals.starlightRoute.entry.id !== '404'
	&& !Astro.locals.starlightRoute.entry.id.endsWith('/404');
---

{
	isExperience && (
		<>
			<style is:inline>
				html {
					background: #0f1219;
					color-scheme: dark;
				}

				body {
					background: #0f1219;
					color: #c5ced6;
				}
			</style>
			<script is:inline>
				(function () {
					var root = document.documentElement;
					root.dataset.theme = 'dark';
					root.style.colorScheme = 'dark';
					var observer = new MutationObserver(function () {
						if (root.dataset.theme !== 'dark') root.dataset.theme = 'dark';
					});
					observer.observe(root, { attributes: true, attributeFilter: ['data-theme'] });
				})();
			</script>
		</>
	)
}
<Default />
<AdSenseVerification />
<AdcashAutotag />
{isDocument && <GuideStructuredData />}
{
	isExperience && (
		<script is:inline>
			document.documentElement.dataset.theme = 'dark';
			document.documentElement.style.colorScheme = 'dark';
		</script>
	)
}
<Analytics />
<VercelAnalytics />
