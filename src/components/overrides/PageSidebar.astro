---
import NextInRoute from '../NextInRoute.astro';
import { isCategoryLandingPath } from '../../lib/guides';

const { entry } = Astro.locals.starlightRoute;
const isSplash = entry.data.template === 'splash';
const path = Astro.url.pathname.replace(/\/+$/, '');
const isGameplayHub = path === '/mortal-shell-ii/gameplay';
const isGuidesIndex = path === '/mortal-shell-ii/guides';
const isRouteHub = path.match(/^\/mortal-shell-ii\/(start|weapons|power|explore|trials)$/);
const isArticle =
	!isSplash &&
	!isCategoryLandingPath(Astro.url.pathname) &&
	!isGameplayHub &&
	!isGuidesIndex &&
	!isRouteHub;
---

{isArticle && (
	<div class="nir-desktop">
		<NextInRoute />
	</div>
)}
