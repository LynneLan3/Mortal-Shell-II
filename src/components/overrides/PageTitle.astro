---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import GuideBreadcrumb from '../GuideBreadcrumb.astro';
import GuideStatus from '../GuideStatus.astro';
import GuideIntro from '../GuideIntro.astro';
import { isCategoryLandingPath } from '../../lib/guides';
import { routeForGuide, editorialForGuide } from '../../lib/routes';
import { headerVisual } from '../../lib/guideVisuals';

const { entry } = Astro.locals.starlightRoute;
const isSplash = entry.data.template === 'splash';
const isCategoryLanding = isCategoryLandingPath(Astro.url.pathname);
const path = Astro.url.pathname.replace(/\/+$/, '');
const isGameplayHub = path === '/mortal-shell-ii/gameplay';
const isGuidesIndex = path === '/mortal-shell-ii/guides';
const isRouteHub = path.match(/^\/mortal-shell-ii\/(start|weapons|power|explore|trials)$/);
const isArticle = !isSplash && !isCategoryLanding && !isGameplayHub && !isGuidesIndex && !isRouteHub;
const lastUpdated = entry.data.lastUpdated instanceof Date ? entry.data.lastUpdated : undefined;
const editorial = isArticle ? editorialForGuide(entry) : undefined;

const wordCount = isArticle && entry.body ? entry.body.split(/\s+/).length : 0;
const readTime = wordCount > 0 ? Math.max(1, Math.round(wordCount / 230)) : 0;
const headerImg = isArticle ? headerVisual(entry) : undefined;
const facts = isArticle ? (editorial?.facts ?? []) : [];
---

{isArticle && <div data-guide-detail hidden></div>}

{
	isArticle && (
		<>
			<header class="gd-hero" data-guide-hero>
				{headerImg && (
					<div class="gd-hero__cover">
						<img
							src={headerImg.src}
							alt={headerImg.alt}
							width="1600" height="800"
							loading="eager" fetchpriority="high"
							style={headerImg.position ? `object-position: ${headerImg.position}` : ''}
						/>
						<div class="gd-hero__overlay"></div>
					</div>
				)}
				<div class="gd-hero__content">
					<GuideBreadcrumb />
					{editorial?.eyebrow && <span class="gd-eyebrow">{editorial.eyebrow}</span>}
					<h1 class="gd-hero__title">{entry.data.title}</h1>
					{entry.data.description && <p class="gd-dek">{entry.data.description}</p>}
					<div class="gd-meta">
						{entry.data.status && <GuideStatus status={entry.data.status} />}
						{lastUpdated && (
							<time datetime={lastUpdated.toISOString()}>
								Updated {lastUpdated.toISOString().slice(0, 10)}
							</time>
						)}
						{readTime > 0 && <span>{readTime} min read</span>}
					</div>
				</div>
				{facts.length > 0 && (
					<dl class="gd-facts">
						{facts.map((f) => (
							<div class="gd-fact">
								<dt>{f.label}</dt>
								<dd>{f.value}</dd>
							</div>
						))}
					</dl>
				)}
			</header>

			<div class="gd-body">
				<GuideIntro />
			</div>
		</>
	)
}

{!isArticle && !isSplash && !isGameplayHub && !isGuidesIndex && !isRouteHub && (
	<Default>
		<slot />
	</Default>
)}
