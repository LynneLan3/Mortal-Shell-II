---
import GameShell from '../../components/experience/GameShell.astro';
import ExperienceHomepage from '../../components/experience/ExperienceHomepage.astro';
import { getImage } from 'astro:assets';
import { game } from '../../config/game';
import { resolveGameAsset } from '../../lib/assets';
import { experienceNav } from '../../lib/experience-nav';
import '../../styles/experience-homepage.css';
import ExperienceStructuredData from '../../components/ExperienceStructuredData.astro';

const { nav, footerLinks, homeHref } = experienceNav();
const heroImage = resolveGameAsset(game.heroImage, 'game.heroImage');
const heroPreload = heroImage
	? await getImage({
			src: heroImage,
			width: 1280,
			height: 414,
			format: 'webp',
			quality: 72,
		})
	: undefined;
---

<GameShell
	title={game.homepageSeoTitle ?? game.hubTitle ?? game.title ?? game.shortName}
	description={game.description}
	canonical={new URL(game.hubPath, game.siteUrl).href}
	siteTitle={game.shortName}
	homeHref={homeHref}
	nav={nav}
	activePath={game.hubPath}
	accentColor={game.accentColor}
	accentForeground={game.accentForeground}
	footerLinks={footerLinks}
	footerText={game.title}
>
	<ExperienceStructuredData
		slot="head"
		title={game.homepageSeoTitle ?? game.hubTitle ?? `${game.name} Guide & Wiki`}
		description={game.description}
		canonical={new URL(game.hubPath, game.siteUrl).href}
		breadcrumbs={[{ name: game.name, href: new URL(game.hubPath, game.siteUrl).href }]}
	/>
	{heroPreload && (
		<link
			slot="head"
			rel="preload"
			as="image"
			href={heroPreload.src}
			fetchpriority="high"
			imagesrcset={heroPreload.srcSet?.attribute}
			imagesizes="(max-width: 768px) 100vw, 1280px"
		/>
	)}
	<ExperienceHomepage />
</GameShell>
