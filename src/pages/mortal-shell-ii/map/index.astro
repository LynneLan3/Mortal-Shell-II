---
import GameShell from '../../../components/experience/GameShell.astro';
import InteractiveMap from '../../../components/experience/InteractiveMap.astro';
import { game } from '../../../config/game';
import { mapMarkers } from '../../../data/map-markers';
import { experienceNav } from '../../../lib/experience-nav';
import '../../../styles/map.css';
import '../../../styles/completion.css';
import '../../../styles/map-simplification.css';

const mapPath = `${game.hubPath}map/`;
const { nav, footerLinks, homeHref } = experienceNav();
---

<GameShell
	title="Mortal Shell 2 Free Exploration Map — Player Toolkit"
	description="Explore the Mortal Shell 2 verified world map, search guide-backed targets, and save completion progress locally."
	canonical={new URL(mapPath, game.siteUrl).href}
	siteTitle={game.shortName}
	homeHref={homeHref}
	nav={nav}
	activePath={mapPath}
	accentColor={game.accentColor}
	accentForeground={game.accentForeground}
	footerLinks={footerLinks}
	footerText={game.title}
>
	<InteractiveMap markers={mapMarkers} />
</GameShell>
